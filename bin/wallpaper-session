#!/bin/bash
# Draws the recorded wallpaper state; the single place that knows how.
# Spawned by niri at session start (config/niri/misc.kdl) and re-spawned
# by wallset after it records a new image — so the wallpaper persists
# across logins by construction and no command ever needs re-running.
if [ -f "$HOME/Pictures/wallpaper.jpg" ]; then
    exec swaybg -i "$HOME/Pictures/wallpaper.jpg" -m fill
else
    exec swaybg -c '#0d0d0d'
fi

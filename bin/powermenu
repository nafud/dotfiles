#!/bin/bash
# powermenu — session actions through the rofi dmenu (Mod+Escape).
# Picking an entry is the confirmation step, so every action is direct.
set -euo pipefail

choice="$(printf 'lock\nsuspend\nlogout\nreboot\nshutdown\n' \
    | "$HOME/.local/bin/rofi-toggle" -dmenu -p power)" || exit 0
[ -n "$choice" ] || exit 0

case "$choice" in
    lock)     exec "$HOME/.local/bin/lock" ;;
    suspend)  exec systemctl suspend ;;
    logout)   exec niri msg action quit --skip-confirmation ;;
    reboot)   exec systemctl reboot ;;
    shutdown) exec systemctl poweroff ;;
esac

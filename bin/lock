#!/bin/bash
# lock — the one lock entrypoint (Mod+Shift+L, the power menu, swayidle).
# hyprlock draws the whole scene from config/hypr/hyprlock.conf: the
# wallpaper blurred and sunk toward the theme ground on the GPU, the
# hour, the layout mark, the ring.
#
# hyprlock holds the foreground until unlock, but swayidle -w needs this
# command to return once the session is LOCKED — waiting for the unlock
# would stall before-sleep, and returning before the lock is up would
# let suspend race it. So hyprlock runs in the background and this
# returns on logind's locked hint (niri raises it when the lock is
# accepted), with a bounded wait should the hint never come.

# a missing locker must not pass for a lock: swayidle -w would carry
# on into suspend, the keybind would do nothing — say so and fail
command -v hyprlock >/dev/null || {
    notify-send -u critical "lock" "hyprlock is not installed — the session is not locked"
    echo "lock: hyprlock not installed" >&2
    exit 1
}

# the session lock is single-holder: locked already means done
pgrep -x -u "$(id -u)" hyprlock >/dev/null && exit 0

hyprlock >/dev/null 2>&1 &
if [ -n "${XDG_SESSION_ID:-}" ]; then
    for _ in $(seq 1 30); do
        [ "$(loginctl show-session "$XDG_SESSION_ID" -p LockedHint --value 2>/dev/null)" = "yes" ] \
            && exit 0
        sleep 0.1
    done
else
    sleep 1
fi
exit 0

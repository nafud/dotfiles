#!/bin/bash
# wallset IMAGE — change the wallpaper, once. Records the image as
# ~/Pictures/wallpaper.jpg (the state bin/wallpaper draws at every
# login, so the change persists) and re-applies live when a session
# is up, by restarting the unit that draws it.
set -euo pipefail

img="${1:?usage: wallset IMAGE}"

mkdir -p "$HOME/Pictures"
cp -- "$img" "$HOME/Pictures/wallpaper.jpg"

# the lock screen blurs the file itself on the next lock; the login
# page's copy is rendered by setup.sh, which has the privilege to place it
if systemctl --user -q is-active graphical-session.target; then
    systemctl --user restart wallpaper.service
fi

echo "wallpaper recorded (persists across logins)"

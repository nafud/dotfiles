{
    "layer": "top",
    "position": "top",
    "height": 24,
    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,
    "modules-left": ["niri/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/updates", "privacy", "systemd-failed-units", "custom/recording", "bluetooth", "group/levels", "network", "custom/mullvad", "niri/language"],

    "custom/updates": {
        "exec": "~/.config/waybar/updates.sh",
        "return-type": "json",
        "interval": 1800,
        "signal": 8,
        "format": "{}",
        "on-click": "~/.config/waybar/updates.sh gui"
    },

    "custom/recording": {
        "exec": "~/.config/waybar/recording.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "format": "{}",
        "on-click": "~/.local/bin/record-toggle"
    },

    "bluetooth": {
        "format": "",
        "format-no-controller": "",
        "format-disabled": "",
        "format-off": "",
        "format-on": "<span size='88.0%' rise='486' letter_spacing='610'>󰂯</span>",
        "format-connected": "<span size='88.0%' rise='486' letter_spacing='4717'>󰂱</span> {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "alacritty --class bluetui-float -e bluetui"
    },

    "custom/mullvad": {
        "exec": "~/.config/waybar/mullvad.sh",
        "return-type": "json",
        "restart-interval": 3,
        "format": "{}",
        "on-click": "~/.config/waybar/mullvad.sh gui",
        "on-click-right": "~/.config/waybar/mullvad.sh toggle"
    },

    "niri/language": {
        "format": "{shortDescription}",
        "tooltip": false,
        "on-click": "niri msg action switch-layout next"
    },

    "tray": { "icon-size": 11, "spacing": 16 },
    "privacy": {
        "icon-size": 11, "icon-spacing": 16,
        "modules": [ { "type": "screenshare" }, { "type": "audio-in" } ]
    },
    "systemd-failed-units": {
        "format": "<span size='92.4%' rise='284' letter_spacing='8628'>󰀦</span> {nr_failed}", "hide-on-ok": true,
        "on-click": "alacritty --class btop-float -e sh -c 'systemctl --failed; systemctl --user --failed; printf \"\\nEnter to close \"; read -r _'"
    },
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": { "empty": "○", "default": "●" },
        "on-click-right": "niri msg action toggle-overview",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "group/levels": { "orientation": "inherit", "modules": ["memory", "pulseaudio", "battery"] },
    "memory": { "format": "<span letter_spacing='12288'></span> {percentage:>2}%", "interval": 5,
                "on-click": "alacritty --class btop-float -e btop" },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "<span letter_spacing='6144'>󰝟</span> mute",
        "format-icons": { "default": ["<span letter_spacing='-1352'>󰕿</span>", "<span letter_spacing='983'>󰖀</span>", "<span letter_spacing='5161'>󰕾</span>"] },
        "scroll-step": 5,
        "max-volume": 200,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "<span size='88.0%' rise='486' letter_spacing='394'>󰂄</span> {capacity}%",
        "format-plugged": "<span size='88.0%' rise='486' letter_spacing='394'>󰂄</span> {capacity}%",
        "format-full": "<span size='88.0%' rise='486' letter_spacing='394'>󰂄</span> {capacity}%",
        "format-icons": ["<span size='88.0%' rise='486' letter_spacing='394'>󰁺</span>", "<span size='88.0%' rise='486' letter_spacing='394'>󰁼</span>", "<span size='88.0%' rise='486' letter_spacing='394'>󰁾</span>", "<span size='88.0%' rise='486' letter_spacing='394'>󰂀</span>", "<span size='88.0%' rise='486' letter_spacing='394'>󰁹</span>"],
        "states": { "critical": 15 }
    },
    "network": {
        "format-wifi": "<span size='97.3%' letter_spacing='8531'>󰖩</span> {signalStrength}%",
        "format-ethernet": "<span size='92.4%' rise='284' letter_spacing='6698'>󰈀</span> up",
        "format-disconnected": "<span size='97.3%' letter_spacing='8770'>󰖪</span> down",
        "on-click": "~/.local/bin/netmenu",
        "on-click-right": "alacritty --class nmtui-float -e nmtui"
    },
    "clock": { "format": "{:%a %d %b  %H:%M:%S}", "interval": 1, "tooltip": false }
}

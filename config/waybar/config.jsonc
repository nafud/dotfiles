{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,
    "modules-left": ["custom/workspaces"],
    "modules-center": ["group/stats"],
    "modules-right": ["tray", "custom/updates", "group/levels", "custom/vpn", "network", "custom/layout", "clock", "custom/power"],

    "custom/updates": {
        "exec": "~/.config/waybar/updates.sh",
        "return-type": "json",
        "interval": 1800,
        "signal": 8,
        "format": "{}",
        "on-click": "~/.config/waybar/updates.sh gui"
    },

    "custom/layout": {
        "exec": "~/.config/waybar/layout.sh",
        "restart-interval": 3,
        "format": "{}",
        "tooltip": false,
        "on-click": "niri msg action switch-layout next"
    },

    "custom/vpn": {
        "exec": "~/.config/waybar/vpn.sh",
        "return-type": "json",
        "restart-interval": 3,
        "format": "{}",
        "on-click": "~/.config/waybar/vpn.sh gui",
        "on-click-right": "~/.config/waybar/vpn.sh toggle"
    },

    "tray": { "icon-size": 16, "spacing": 8 },

    "custom/workspaces": {
        "exec": "~/.config/waybar/workspaces.sh",
        "restart-interval": 3,
        "format": "{}",
        "on-click": "niri msg action toggle-overview",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "group/stats": { "orientation": "inherit", "modules": ["temperature", "cpu", "memory"] },
    "group/levels": { "orientation": "inherit", "modules": ["pulseaudio", "backlight", "battery"] },

    "temperature": { "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon", "input-filename": "temp1_input",
                     "critical-threshold": 80, "format": " {temperatureC}°C", "interval": 5 },
    "cpu": { "format": " {usage}%", "interval": 3,
             "on-click": "alacritty --class btop-float -e btop" },
    "memory": { "format": "<span size='138%'>󰘚</span> {percentage}%", "interval": 5,
                "on-click": "alacritty --class btop-float -e btop" },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mute",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "backlight": { "format": "{icon} {percent}%", "format-icons": ["󰃞", "󰃟", "󰃠"] },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": { "critical": 15 }
    },
    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 up",
        "format-disconnected": "󰖪 down",
        "on-click": "alacritty --class nmtui-float -e nmtui"
    },
    "clock": { "format": "󰥔 {:%a %d %b  %H:%M:%S}", "interval": 1, "tooltip": false },
    "custom/power": { "format": "", "tooltip": false,
                      "on-click": "sh -c \"$HOME/.local/bin/powermenu\"" }
}

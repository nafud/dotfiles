# swaylock theme — the unlock indicator in the house mono palette.
# The wallpaper image is per-lock state, so bin/lock passes it on the
# command line; `color` is only the ground behind a missing image.
# Colors are rrggbb[aa]; the disc is translucent so the wallpaper
# reads through it instead of punching a black hole in the blur.
color=0d0d0d
font=JetBrainsMono Nerd Font
font-size=18
# always visible: the lock state is readable at a glance, and a caps
# warning can show before the first keystroke
indicator-idle-visible
indicator-radius=100
indicator-thickness=7
inside-color=0d0d0d99
inside-ver-color=0d0d0d99
inside-wrong-color=0d0d0d99
inside-clear-color=0d0d0d99
ring-color=666666aa
ring-ver-color=98b898ff
ring-wrong-color=b5626aff
ring-clear-color=666666ff
key-hl-color=98b898ff
bs-hl-color=b5626aff
text-color=c0c0c0ff
text-ver-color=c0c0c0ff
text-wrong-color=b5626aff
text-clear-color=c0c0c0ff
line-color=00000000
separator-color=00000000
ignore-empty-password
show-failed-attempts

# keyboard layout under the ring: swaylock shows the xkb name on its
# own once more than one layout is configured (config/niri/input.kdl);
# the box it draws around the text is dropped so the name sits on the
# blur like the rest
layout-bg-color=00000000
layout-border-color=00000000
layout-text-color=c0c0c0ff

# caps lock: warn in the muted yellow before a password goes in wrong
indicator-caps-lock
inside-caps-lock-color=0d0d0d99
ring-caps-lock-color=b0a06aff
caps-lock-key-hl-color=b0a06aff
caps-lock-bs-hl-color=b5626aff
text-caps-lock-color=b0a06aff

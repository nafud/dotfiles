theme "mono"

themes {
    mono {
        fg "#c0c0c0"
        bg "#0d0d0d"
        black "#1a1a1a"
        red "#b5626a"
        green "#7f9f7f"
        yellow "#b0a06a"
        blue "#7a91a8"
        magenta "#9a86a8"
        cyan "#7fa8a0"
        white "#e8e8e8"
        orange "#b0a06a"
    }
}

simplified_ui true
// no boxes around panes — splits separate by gap alone, the slick look
pane_frames false

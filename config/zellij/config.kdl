theme "mono"

themes {
    mono {
        fg "#c0c0c0"
        bg "#0d0d0d"
        black "#1a1a1a"
        red "#b5626a"
        green "#7f9f7f"
        yellow "#b0a06a"
        blue "#7a91a8"
        magenta "#9a86a8"
        cyan "#7fa8a0"
        white "#e8e8e8"
        orange "#b0a06a"
    }
}

simplified_ui true
// no boxes around panes — splits separate by gap alone, the slick look
pane_frames false

// Locked by default: every Ctrl chord passes through to the app until
// Ctrl+g unlocks zellij's own commands. The stock bindings sit on keys
// micro lives on (Ctrl+s search, and Ctrl+q would quit zellij outright,
// taking every pane with it).
default_mode "locked"

// one slim status line instead of the two hint bars
default_layout "compact"

// selections go straight to the Wayland clipboard
copy_command "wl-copy"

show_startup_tips false

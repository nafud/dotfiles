# Poke the bar's updates module the moment package state changes:
# every pacman install, remove and upgrade rewrites entries under
# local/. Without this the badge waits out the module's 30-minute
# interval after updates are applied.
[Unit]
Description=refresh waybar updates module on package state changes

[Path]
PathModified=/var/lib/pacman/local

[Install]
WantedBy=default.target

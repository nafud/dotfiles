[Unit]
Description=poke waybar updates module
# one pacman transaction touches local/ once per package — the pokes
# must never be rate-limited into a failed unit
StartLimitIntervalSec=0

[Service]
Type=oneshot
# the module subscribes with "signal": 8; a bar that isn't running is
# not a failure
ExecStart=-/usr/bin/pkill -RTMIN+8 -x waybar

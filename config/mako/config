# mako — a floating content surface, dressed like the others: the
# terminal's 11 px face and 10 px padding (alacritty.toml), the
# floating menu's width (rofi themes/menu.rasi), the strip's dark
# glass a shade firmer (0.88 — cards get no blur, see the note in
# niri/decorations.kdl, so the alpha alone carries legibility), radius
# 8 and nothing else: no borders, the workspace's no-chips discipline.
# The card's top-right corner lands on the tiled window's border
# corner, not the focus ring's: the margin is the layout gap
# (niri/layout.kdl) above and on the right, and both are multiples of
# 4 so they are whole pixels at any quarter scale and meet exactly,
# measured at 1.25 (tests/check-session holds the rule and the
# numbers). Summary in the strip's hover
# white over body grey.
# Duplicates group by app and summary instead of stacking. Text only —
# icons stay out. Mod+Shift+D dismisses all from the keyboard
# (config/niri/binds.kdl); a right click on a card does the same.
font=JetBrainsMono Nerd Font 11
background-color=#0d0d0dE0
text-color=#c0c0c0
border-size=0
border-radius=8
width=360
padding=10
margin=8,8
default-timeout=5000
layer=top
icons=0
max-visible=5
max-history=10
group-by=app-name,summary
format=<span color='#e8e8e8'>%s</span>\n%b
progress-color=over #b0a06a33
on-button-right=dismiss-all

[grouped]
format=<span color='#e8e8e8'>%s</span> ×%g\n%b

[urgency=low]
text-color=#909090
default-timeout=4000

# high urgency differs in behaviour, not dress: it never expires and
# sits on the overlay layer above fullscreen windows
[urgency=high]
default-timeout=0
layer=overlay

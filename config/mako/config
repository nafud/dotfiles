# mako — a floating content surface, dressed like the others: the
# terminal's 11 px face and 10 px padding, the floating menu's 360
# width (alacritty.toml, rofi config.rasi and themes/menu.rasi — the
# test pins all three; the card is 361, one wider than the menu: at
# the display's 1.25 scale a right-anchored 360 surface snaps one
# physical pixel past the bar's edge, the odd width lands both edges
# on the same physical column — measured 2026-08-30), the strip's
# dark glass a shade firmer (0.88 —
# cards get no blur, see the note in niri/decorations.kdl, so the
# alpha alone carries legibility), radius 8 and nothing else — no
# borders at all, the workspace's no-chips discipline. Cards sit 5 px from
# the screen edge so their right edge is flush with the bar's; 10 px
# below it and between cards. Summary in the bar's hover white, body in
# its resting grey, both at the bar's 12 px. Duplicates group by app
# and summary instead of stacking. Text only — icons stay out.
# Mod+Shift+D dismisses all from the keyboard (config/niri/binds.kdl);
# a right click anywhere on a notification does the same.
font=JetBrainsMono Nerd Font 11
background-color=#0d0d0dE0
text-color=#c0c0c0
border-size=0
border-radius=8
width=361
padding=10
margin=10,5
default-timeout=5000
layer=top
icons=0
max-visible=5
max-history=10
group-by=app-name,summary
format=<span color='#e8e8e8'>%s</span>\n%b
progress-color=over #b0a06a33
on-button-right=dismiss-all

[grouped]
format=<span color='#e8e8e8'>%s</span> ×%g\n%b

[urgency=low]
text-color=#909090
default-timeout=4000

# high urgency differs in behaviour, not dress: it never expires and
# sits on the overlay layer above fullscreen windows
[urgency=high]
default-timeout=0
layer=overlay

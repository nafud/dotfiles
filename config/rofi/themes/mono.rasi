/* Mono launcher theme matching the desktop, styled after the kiln jump
   palette: a bordered 0.9-glass panel whose selected row is an accent
   tint with accent text (the palette's highlight), not a grey block.
   The glass is the panel's own alpha — rofi 2.0's layer surface spans
   the whole output, so compositor blur behind it would frost the
   entire screen and is deliberately not used. */
* {
    bg:        #0d0d0dE6;
    fg:        #c0c0c0;
    bright:    #e8e8e8;
    muted:     #666666;
    accent:    #98b898;
    border:    #2a2a2a;
    highlight: #98b89826;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 8px;
    width: 480px;
    padding: 8px;
}

inputbar {
    children: [ prompt, entry ];
    padding: 6px 8px;
}

prompt {
    text-color: @accent;
    padding: 0 10px 0 0;
}

entry {
    text-color: @bright;
}

/* faint rule between prompt and results, the palette's two-surface look */
listview {
    lines: 10;
    padding: 6px 0 0 0;
    margin: 6px 0 0 0;
    border: 1px 0 0 0;
    border-color: @border;
    scrollbar: false;
}

element {
    padding: 4px 8px;
    border-radius: 4px;
}

element-text {
    text-color: inherit;
}

element selected {
    background-color: @highlight;
    text-color: @accent;
}

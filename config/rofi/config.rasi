/* Behavior only; the look lives in themes/mono.rasi (rofi's canonical
   split — inline theme blocks inside config.rasi are not reliably
   honored, which left the default theme showing). */
configuration {
    modes: "drun,run";
    font: "JetBrainsMono Nerd Font 11";
    show-icons: false;
    display-drun: "λ";
    display-run: ">";
    drun-display-format: "{name}";
}

@theme "mono"

layout {
    focus-ring {
        width 2
        active-color "#e8e8e8"
        inactive-color "transparent"
    }
    border {
        on
        width 1
        active-color "#33333388"
        inactive-color "#33333388"
    }
    shadow { off; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    // Every length that meets a screen edge or another surface — this
    // gap, the bar's height and margins, the cards' margin and width
    // (config/waybar/config.jsonc, config/mako/config) — is a multiple
    // of 4 logical px: whole in physical pixels at every quarter scale
    // (1, 1.25, 1.5, 1.75, 2), so nothing rounds and the bar's edges,
    // the cards' corner and the windows' border meet on the same pixel
    // column on any panel. tests/check-session holds the rule.
    gaps 8
}

input {
    keyboard {
        xkb {
            // us, az, ru in that order — the order is the Alt+Shift
            // cycle; grp: is the xkb group switch, deliberately not a
            // compositor bind so it also works on the lock screen
            layout "us,az,ru"
            options "grp:alt_shift_toggle"
        }
        repeat-delay 500
        repeat-rate 30
        numlock
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.4
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// Pointer polish: one cursor theme at one size everywhere (GTK apps
// follow via the gsettings in apply_desktop_prefs), and the cursor
// hides the moment typing starts.
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
    hide-when-typing
}

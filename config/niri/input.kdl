input {
    keyboard {
        xkb {
            // list layouts comma-separated ("us,de") and Alt+Shift
            // cycles them; grp: is the xkb group switch, deliberately
            // not a compositor bind so it also works on the lock
            // screen. The bar shows the current one as its two-letter
            // mark (waybar's niri/language, config/waybar/config.jsonc);
            // the lock's marks under its ring are listed in this order
            // (config/hypr/hyprlock.conf), and the login page's greeter
            // niri carries the same list (system/etc/greetd/niri.kdl) —
            // tools/check holds the three together.
            layout "us,ru,az"
            options "grp:alt_shift_toggle"
        }
        repeat-delay 500
        repeat-rate 30
        numlock
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.4
    }
    // Pointer focus is off. niri's focus-follows-mouse does not know that a
    // dialog belongs to the window under the pointer, so crossing the parent
    // on the way to a dialog took the focus from the dialog and left the
    // keyboard on a window the dialog was blocking (niri 26.04, any toolkit,
    // Wayland and X11). Focus changes by click or keyboard until that is
    // fixed upstream.
    // focus-follows-mouse max-scroll-amount="0%"
}

// Pointer polish: one cursor theme at one size everywhere (GTK apps
// follow via the gsettings in apply_desktop_prefs), and the cursor
// hides the moment typing starts.
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
    hide-when-typing
}

// Slightly rounded corners on every window, clipped so window content
// follows the curve. Compositor-level: alacritty cannot round its own
// corners, niri rounds any window; borders and the focus ring follow
// the radius automatically. A rule with no match applies to all.
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// The layout owns window geometry: apps that remember a maximized
// state across restarts (browsers, chat clients) are denied it, so
// every window opens as a regular framed tile. Mod+F still maximizes a
// column on demand.
window-rule {
    open-maximized false
}

// Frosted ground behind the semitransparent terminals and Files (its
// 0.9 glass is config/gtk-4.0/gtk.css): xray blur (the niri default
// when blur is on) blurs the wallpaper once and reuses it, so it costs
// almost nothing. draw-border-with-background false keeps the border
// from tinting through the glass (see the niri FAQ) — for a GTK window
// niri would otherwise paint the #33333388 border colour behind the
// whole window.
window-rule {
    match app-id="^Alacritty"
    match app-id="-float$"
    match app-id=r#"^org\.gnome\.Nautilus$"#
    draw-border-with-background false
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="^Alacritty-floating$"
    open-floating true
}

// imv letterboxes images on the theme ground (config/imv/config); the
// window rides the shared 0.9 glass like every other surface. The
// photo itself is 10% translucent as a consequence — remove this rule
// when exact color viewing matters.
window-rule {
    match app-id="^imv$"
    opacity 0.9
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// every terminal popup class ends in -float (btop, nmtui, pulsemixer);
// one rule floats them all. A floating terminal takes its own size
// (alacritty's default, ~100x38 cells here) unless the rule sets both
// width and height — a width alone is ignored.
window-rule {
    match app-id="-float$"
    open-floating true
}

// nmtui: its widest screen, the connection editor, is 78 columns; at
// the terminal's default size its small dialogs sit adrift in glass
window-rule {
    match app-id="^nmtui-float$"
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.65; }
}

// The bar pills, launcher and notifications are layer-shell surfaces,
// so their blur comes from layer rules. Each surface carries its own
// alpha in its config (the bar 0.6, launcher and notifications 0.9).
layer-rule {
    match namespace="waybar"
    background-effect {
        blur true
    }
}

// rofi carries no blur rule: its 2.0 layer surface is anchored to all
// four output edges (the panel floats inside a screen-sized transparent
// surface), so a blur behind it would frost the whole screen. Its glass
// is the panel's own alpha in themes/mono.rasi.

// no blur for notifications: niri blurs a surface's whole rectangle
// plus a soft rim beyond it, which reads as a hazy box around a
// floating rounded card (the bar spans its strip, so the same rim is
// invisible there); mako's cards carry their own alpha instead

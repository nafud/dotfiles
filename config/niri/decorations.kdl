// Slightly rounded corners on every window, clipped so window content
// follows the curve. Compositor-level: alacritty cannot round its own
// corners, niri rounds any window; borders and the focus ring follow
// the radius automatically. A rule with no match applies to all.
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// The layout owns window geometry: apps that remember a maximized
// state across restarts (Telegram, Firefox) are denied it, so every
// window opens as a regular framed tile. Mod+F still maximizes a
// column on demand.
window-rule {
    open-maximized false
}

// Frosted ground behind the semitransparent terminals: xray blur (the
// niri default when blur is on) blurs the wallpaper once and reuses it,
// so it costs almost nothing. draw-border-with-background false keeps
// the border from tinting through the glass (see the niri FAQ).
window-rule {
    match app-id="^Alacritty"
    match app-id="-float$"
    draw-border-with-background false
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="^Alacritty-floating$"
    open-floating true
}

// imv letterboxes images on the theme ground (config/imv/config); the
// window rides the shared 0.9 glass like every other surface. The
// photo itself is 10% translucent as a consequence — remove this rule
// when exact color viewing matters.
window-rule {
    match app-id="^imv$"
    opacity 0.9
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// every terminal popup class ends in -float (btop, nmtui, pulsemixer);
// one rule floats them all at the same size
window-rule {
    match app-id="-float$"
    open-floating true
    default-column-width { proportion 0.7; }
}

// The bar pills, launcher and notifications are layer-shell surfaces,
// so their blur comes from layer rules. Their surfaces carry the same
// 92% alpha in their own configs.
layer-rule {
    match namespace="waybar"
    background-effect {
        blur true
    }
}

// rofi carries no blur rule: its 2.0 layer surface is anchored to all
// four output edges (the panel floats inside a screen-sized transparent
// surface), so a blur behind it would frost the whole screen. Its glass
// is the panel's own alpha in themes/mono.rasi.

layer-rule {
    match namespace="^notifications$"
    background-effect {
        blur true
    }
}

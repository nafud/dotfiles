prefer-no-csd

environment {
    _JAVA_AWT_WM_NONREPARENTING "1"
    MOZ_ENABLE_WAYLAND "1"
}

spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/wallpaper-session"
spawn-at-startup "swayidle" "-w" "timeout" "600" "$HOME/.local/bin/lock" "timeout" "630" "niri msg action power-off-monitors" "resume" "niri msg action power-on-monitors" "before-sleep" "$HOME/.local/bin/lock"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/battwatch.sh"
// night light: warm color at night between fixed times — no
// geolocation service involved (-S sunrise, -s sunset)
spawn-at-startup "wlsunset" "-S" "07:00" "-s" "21:00"

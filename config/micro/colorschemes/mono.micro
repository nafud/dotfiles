# Kiln mono colorscheme. ANSI names only, so the hellwal wallpaper
# palette flows through it like the rest of the terminal; the default
# background stays the terminal's, keeping the 0.9 glass. Restrained:
# strings carry the accent green, keywords stand out by brightness not
# hue, chrome sits on the surface black.
color-link default "default,default"
color-link comment "brightblack"
color-link identifier "default"
color-link identifier.class "brightwhite"
color-link constant "cyan"
color-link constant.string "green"
color-link statement "brightwhite"
color-link symbol "default"
color-link symbol.brackets "default"
color-link preproc "magenta"
color-link preproc.shebang "comment"
color-link type "brightcyan"
color-link type.extended "default"
color-link special "magenta"
color-link ignore "default"
color-link error "brightred"
color-link todo "yellow"
color-link hlsearch "black,green"
color-link statusline "brightwhite,black"
color-link tabbar "default,black"
color-link indent-char "brightblack"
color-link line-number "brightblack"
color-link current-line-number "white"
color-link cursor-line ",black"
color-link color-column ",black"
color-link match-brace ",black"
color-link diff-added "green"
color-link diff-modified "yellow"
color-link diff-deleted "red"
color-link gutter-error "brightred"
color-link gutter-warning "yellow"
color-link tab-error "brightred"
color-link trailingws "brightred"

#!/bin/bash
# render-plymouth-mono — draws the images of the mono plymouth theme
# into system/usr/share/plymouth/themes/mono (committed alongside
# mono.plymouth and mono.script; re-run after a design change). One
# image: the typed character's dot, the lock screen's measure
# (config/hypr/hyprlock.conf; the login page, system/usr/local/bin/
# monogreet, follows it) on the 0d0d0d ground.
#   bullet.png    one typed character: a 6px c0c0c0 dot in a 12px cell,
#                 the script sets the row of them on the line above the prompt
# The theme draws nothing else: no ring, no field, no throbber, no lock
# glyph — the text it is asked to show, and the dots.
set -euo pipefail

out="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/system/usr/share/plymouth/themes/mono"
mkdir -p "$out"

# PNG32 keeps the image RGBA — ImageMagick would otherwise store a
# grey-only one as grayscale without alpha, and plymouth composites
# with alpha; without the date chunks a rerun writes the same bytes, so
# git sees a change only when the image changed. ImageMagick addresses
# pixel centres: a 6px dot centred in the 12px cell is the circle about
# (5.5, 5.5) through (5.5, 8.5)
magick -size 12x12 xc:none -fill '#c0c0c0' -draw "circle 5.5,5.5 5.5,8.5" \
    -define png:exclude-chunks=date,tIME "PNG32:$out/bullet.png"

echo "rendered $(find "$out" -name '*.png' | wc -l) image(s) into $out"

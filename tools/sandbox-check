#!/bin/bash
# sandbox-check — the measuring tool for the service boundaries, the
# systemd drop-ins under system/etc/systemd/system that give the
# machine's root daemons an explicit scope (which capabilities, paths,
# devices, socket families and system calls each may use). The
# drop-ins are installed by `setup.sh system`; this tool is how they
# are proven, in the order the rollout runs them:
#
#   score            offline: score every boundary against the vendored
#                    copies of the packages' unit files
#                    (tests/fixtures/units) with systemd-analyze
#                    security, and fail when one exceeds its bound —
#                    the bound each drop-in was written to. No root,
#                    no running system needed; tests/check-system runs
#                    this.
#   render UNIT      print UNIT's drop-in in learning mode: the
#                    SystemCallFilter= line becomes a SystemCallLog=
#                    deny-list of the same set, SystemCallErrorNumber=
#                    goes, everything else stays. Under it the kernel
#                    logs (does not block) every system call outside
#                    the intended set — the seccomp SECCOMP_RET_LOG
#                    action the kernel documents for exactly this:
#                    learning what a program needs without a
#                    kill-and-retry cycle. Every other directive is
#                    already enforced, so their failures show in the
#                    unit's own journal as EROFS/EACCES/EPERM.
#   learn            (root) install the whole layer in learning mode:
#                    the rendered drop-ins plus the layer's own units,
#                    daemon-reload, try-restart the daemons. The boot
#                    oneshots are not restarted (see setup.sh).
#   report [UNIT...] live, no root: each unit's state, its main
#                    process's bounding set (decoded), no_new_privs and
#                    seccomp mode, its exposure score, the warnings in
#                    its journal since it started, and — for the whole
#                    boot — every seccomp log record, decoded to the
#                    syscall's name and grouped by program, so a
#                    learning run reads as a list of what to allow.
#                    Only SECCOMP_RET_LOG records are shown
#                    (code=0x7ffc0000); a kill from an enforced filter
#                    is a different code and shows up as the unit
#                    dying, not here.
#
# Records reach the kernel log even with auditd off: audit_seccomp()
# is not gated by audit_enabled and, with no audit daemon connected,
# kauditd prints the record through printk. They are rate-limited by
# the kernel like any printk; a burst can drop lines, so a clean
# report is strong evidence, not proof — the enforce stage and
# `report` again are the proof.
#
# Needs: systemd-analyze, journalctl, capsh (libcap), ausyscall (audit).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
REPO="$PWD"
LAYER="$REPO/system/etc/systemd/system"
FIXTURES="$REPO/tests/fixtures/units"

# The score each drop-in measured when written, on systemd-analyze's
# own 0–100 scale (the printed score × 10), and the bound it may not
# exceed: exactly the measurement, since the cheapest directive costs 1
# on this scale and any slack would let one go unnoticed. CI scores on
# the same Arch systemd, so there is no version drift to allow for; a
# new systemd that scores differently is a deliberate re-measurement.
declare -A BOUND=(
    [wpa_supplicant]=23
    [mullvad-daemon]=23
    [mullvad-early-boot-blocking]=17
    [mullvad-net-cls]=41
    [thermald]=20
    [grub-btrfsd]=17
    [udisks2]=52
)

die() { printf 'sandbox-check: %s\n' "$*" >&2; exit 1; }
usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
}

# units — the boundary units, BOUND's keys in order; every one must
# have a drop-in or a unit file in the layer, and score() checks the
# converse, that no hardening.conf in the layer lacks a bound
units() {
    local unit
    for unit in $(printf '%s\n' "${!BOUND[@]}" | sort); do
        [ -f "$LAYER/$unit.service.d/hardening.conf" ] || [ -f "$LAYER/$unit.service" ] \
            || die "$unit has a bound but no file under system/etc/systemd/system"
        echo "$unit"
    done
}
# dropin UNIT — the drop-in's path, or nothing for a unit the layer ships whole
dropin() { [ -f "$LAYER/$1.service.d/hardening.conf" ] && echo "$LAYER/$1.service.d/hardening.conf"; }

# ---------------------------------------------------------------- score ---
# A fake root holds the fixtures as /usr/lib and the layer as /etc;
# systemd-analyze security --offline reads exactly what the running
# manager would. One unit over its bound fails the whole command.
score() {
    local root d unit line value rc=0
    root="$(mktemp -d -t sandbox-check.XXXXXX)"
    trap 'rm -rf "$root"' RETURN
    mkdir -p "$root/usr/lib/systemd/system" "$root/etc/systemd/system"
    cp "$FIXTURES"/*.service "$root/usr/lib/systemd/system/"
    cp -r "$LAYER"/. "$root/etc/systemd/system/"
    for d in "$LAYER"/*.service.d; do
        [ -f "$d/hardening.conf" ] || continue
        unit="$(basename "$d" .service.d)"
        [ -n "${BOUND[$unit]+x}" ] || die "no bound for $unit (add it to BOUND)"
    done
    for unit in $(units); do
        line="$(systemd-analyze security --offline=true --root="$root" --no-pager "$unit.service" 2>/dev/null | tail -n1)"
        value="$(grep -oE '[0-9]+\.[0-9]' <<<"$line" | head -n1)"
        [ -n "$value" ] || die "systemd-analyze gave no score for $unit"
        if [ "${value/./}" -le "${BOUND[$unit]}" ]; then
            printf '  ok    %-30s %s (bound %s.%s)\n' "$unit" "$value" "${BOUND[$unit]%?}" "${BOUND[$unit]: -1}"
        else
            printf '  FAIL  %-30s %s (bound %s.%s)\n' "$unit" "$value" "${BOUND[$unit]%?}" "${BOUND[$unit]: -1}"
            rc=1
        fi
    done
    return "$rc"
}

# --------------------------------------------------------------- render ---
# The drop-in with its filter turned into a log: several
# SystemCallFilter= lines fold into one deny-list (the union of their
# sets), placed where the first stood; SystemCallErrorNumber= is
# dropped, since without a filter it has nothing to apply to.
render() {
    local file sets
    file="$(dropin "$1")" || die "$1 has no drop-in to render"
    sets="$(awk -F= '/^SystemCallFilter=/ { s = s (s == "" ? "" : " ") $2 } END { print s }' "$file")"
    awk -v sets="$sets" '
        /^SystemCallFilter=/ { if (!seen++) print "SystemCallLog=~" sets; next }
        /^SystemCallErrorNumber=/ { next }
        { print }
    ' "$file"
}

# ---------------------------------------------------------------- learn ---
learn() {
    [ "$(id -u)" -eq 0 ] || die "learn installs into /etc: run it as root (sudo tools/sandbox-check learn)"
    local unit file
    for unit in $(units); do
        if file="$(dropin "$unit")"; then
            install -d -m 755 "/etc/systemd/system/$unit.service.d"
            render "$unit" > "/etc/systemd/system/$unit.service.d/hardening.conf"
            chmod 644 "/etc/systemd/system/$unit.service.d/hardening.conf"
            printf 'learning: %s\n' "$unit"
        else
            install -m 644 "$LAYER/$unit.service" "/etc/systemd/system/$unit.service"
            printf 'installed: %s\n' "$unit"
        fi
    done
    systemctl daemon-reload
    # the same restart set as setup.sh's configure_system_services, for the same reasons
    for unit in wpa_supplicant mullvad-daemon thermald grub-btrfsd udisks2; do
        systemctl try-restart "$unit" && printf 'restarted: %s\n' "$unit"
    done
}

# --------------------------------------------------------------- report ---
# caps MASK — capsh's decode without the mask echo: "cap_net_admin,cap_net_raw"
caps() { capsh --decode="$1" | sed 's/^[^=]*=//'; }

report_unit() {
    local unit="$1" pid state since cap nnp seccomp score lines
    state="$(systemctl show -p ActiveState --value "$unit.service" 2>/dev/null || true)"
    printf '\n== %s: %s\n' "$unit" "${state:-not loaded}"
    [ "$state" = active ] || return 0
    pid="$(systemctl show -p MainPID --value "$unit.service")"
    since="$(systemctl show -p ExecMainStartTimestamp --value "$unit.service")"
    if [ "${pid:-0}" -gt 0 ] && [ -r "/proc/$pid/status" ]; then
        cap="$(awk '/^CapBnd:/ { print $2 }' "/proc/$pid/status")"
        nnp="$(awk '/^NoNewPrivs:/ { print $2 }' "/proc/$pid/status")"
        seccomp="$(awk '/^Seccomp:/ { print $2 }' "/proc/$pid/status")"
        printf '   pid %s  CapBnd %s\n   no_new_privs %s  seccomp %s (0 none, 2 filter)\n' \
            "$pid" "$(caps "$cap")" "$nnp" "$seccomp"
    fi
    score="$(systemd-analyze security --no-pager "$unit.service" 2>/dev/null | tail -n1 | grep -oE '[0-9]+\.[0-9] [A-Z]+' || true)"
    printf '   exposure %s\n' "${score:-unknown}"
    local -a window=()
    [ -n "$since" ] && window=(--since "$since")
    printf '   journal since %s (warning and up):\n' "${since:-boot}"
    lines="$(journalctl -q -u "$unit.service" -p warning "${window[@]}" -o cat --no-pager | tail -n 20)"
    printf '%s\n' "${lines:-nothing}" | sed 's/^/     /'
}

# seccomp_log — the boot's SECCOMP_RET_LOG records as "count  program  syscall"
seccomp_log() {
    printf '\n== seccomp log records this boot (learning mode hits)\n'
    local records
    records="$(journalctl -q -k -b -o cat --no-pager | grep -E 'type=1326 .*code=0x7ffc0000' || true)"
    [ -n "$records" ] || { printf '   none\n'; return 0; }
    sed -E 's/.* exe="([^"]*)".* syscall=([0-9]+).*/\1 \2/' <<<"$records" \
        | sort | uniq -c | sort -rn \
        | while read -r count exe nr; do
            printf '   %5s  %-32s %s\n' "$count" "$exe" "$(ausyscall "$nr" 2>/dev/null || echo "syscall $nr")"
        done
}

report() {
    local -a list=("$@")
    [ ${#list[@]} -gt 0 ] || mapfile -t list < <(units)
    local unit
    for unit in "${list[@]}"; do report_unit "$unit"; done
    seccomp_log
}

# ----------------------------------------------------------------- main ---
case "${1:-}" in
    score)  score ;;
    render) [ $# -eq 2 ] || usage; render "$2" ;;
    learn)  learn ;;
    report) shift; report "$@" ;;
    units)  units ;;
    *)      usage ;;
esac

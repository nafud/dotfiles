check "hook: 01-bootkeep-keep"                          t_hook_keep
check "hook: zz-bootkeep-grub"                          t_hook_grub
check "hooks sort around snap-pac and mkinitcpio"       t_hook_order
check "oomd pressure drop-in"                           t_oomd_conf
check "user.slice oomd drop-in"                         t_oomd_user_slice
check "nftables.conf shape"                             t_nft_shape
check "nftables.conf opens ssh to the tailnet only"     t_nft_ssh_tailnet_only
check "nftables.conf admits the libvirt default network" t_nft_libvirt
# a runner may ship unshare yet forbid unprivileged user namespaces
if have nft && unshare -rn true 2>/dev/null; then
    check "nftables.conf parses (nft -c)"               t_nft_syntax
else
    skip "nftables.conf parses (nft -c)" "nft or an unprivileged user namespace unavailable"
fi
check "sshd keys-only drop-in"                          t_sshd_keys_only
check "NetworkManager privacy drop-in"                  t_nm_privacy
check "resolved drop-in"                                t_resolved_dns
check "faillock.conf"                                   t_faillock
check "tlp battery thresholds"                          t_tlp_battery
check "bluetooth AutoEnable off, Privacy device"        t_bluetooth
check "sysctl hardening drop-in"                        t_sysctl
check "modprobe hardening drop-in"                      t_modprobe
check "coredump Storage=none"                           t_coredump_storage
check "journald size cap"                               t_journald_size
check "tmpfiles: /boot 0700"                            t_tmpfiles_boot
check "sudoers: visudo editor pinned"                   t_sudoers_editor
if have visudo; then
    check "sudoers file parses (visudo -cf)"            t_sudoers_parses
else
    skip "sudoers file parses (visudo -cf)" "visudo not installed"
fi
check "tailscaled environment file"                     t_tailscaled_default
check "polkit-agent user unit"                          t_polkit_agent_unit
check "setup.sh: SESSION_UNITS has polkit-agent"        t_setup_session_units
check "setup.sh: pacman line lists the new packages"    t_setup_packages
check "setup.sh: the system functions exist"            t_setup_functions_exist
check "setup.sh: enable_system_units enables the set"   t_setup_enable_units_text
check "setup.sh: configure_boot primes bootkeep"        t_setup_configure_boot_text
if have visudo; then
    check "setup.sh: install modes (sudoers.d 440)"     t_setup_install_modes
    check "setup.sh: a broken sudoers file is refused"  t_setup_sudoers_gate
else
    skip "setup.sh: install modes (sudoers.d 440)" "visudo not installed"
    skip "setup.sh: a broken sudoers file is refused" "visudo not installed"
fi
check "configure_system_services: nftables.conf"        t_services_nftables
check "configure_system_services: resolved.conf.d"      t_services_resolved
check "configure_system_services: tlp.d"                t_services_tlp
check "configure_system_services: nothing changed"      t_services_nothing
check "configure_system_services: tailscaled aside"     t_services_tailscaled_aside
check "configure_system_services: sysctl.d"             t_services_sysctl
check "configure_system_services: journald.conf.d"      t_services_journald
check "configure_system_services: tmpfiles.d"           t_services_tmpfiles
check "configure_system_services: sshd_config.d"        t_services_sshd
check "configure_system_services: default/tailscaled"   t_services_tailscaled
check "configure_system_services: coredump.conf.d"      t_services_coredump_quiet
check "boundary: wpa_supplicant"                        t_boundary_wpa_supplicant
check "boundary: mullvad-daemon"                        t_boundary_mullvad_daemon
check "boundary: mullvad-early-boot-blocking"           t_boundary_mullvad_early_boot
check "boundary: mullvad-net-cls unit"                  t_boundary_net_cls_unit
check "boundary: thermald"                              t_boundary_thermald
check "boundary: grub-btrfsd"                           t_boundary_grub_btrfsd
check "boundary: udisks2"                               t_boundary_udisks2
# --offline scoring wants a systemd-analyze that knows every directive
# the drop-ins use (ProtectControlGroups=strict arrived in 257); an
# older one would score them worse than the machine does
if have systemd-analyze && [ "$(systemd-analyze --version | awk 'NR == 1 { print $2 }')" -ge 257 ] 2>/dev/null; then
    check "boundary: offline scores within bounds"      t_boundary_scores
else
    skip "boundary: offline scores within bounds" "systemd-analyze 257+ not installed"
fi
check "sandbox-check render: filter becomes a log"      t_sandbox_render
check "configure_system_services: a boundary restarts"  t_services_boundary_restart
check "configure_system_services: boot units reload"    t_services_boundary_boot_units
if have shellcheck; then
    check "bootkeep passes shellcheck"                  t_bootkeep_shellcheck
    check "setup.sh passes shellcheck"                  t_setup_shellcheck
else
    skip "bootkeep passes shellcheck" "shellcheck not installed"
    skip "setup.sh passes shellcheck" "shellcheck not installed"
fi

exit "$failed"

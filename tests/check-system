#!/bin/bash
# check-system — acceptance tests for the system/ tree's hardening
# layer and the setup.sh glue that installs it: bootkeep (the kernel
# pair keeper the pacman hooks call), the hooks themselves, and the
# drop-ins for oomd, nftables, sshd, NetworkManager, resolved,
# faillock, tlp, bluetooth, sysctl, modprobe, coredump, journald,
# tmpfiles, sudoers and tailscaled's environment (the daemon itself
# is set aside: installed, not enabled), the service boundaries (the
# *.service.d/hardening.conf drop-ins and mullvad-net-cls.service,
# scored offline by tools/sandbox-check against the vendored unit files
# in tests/fixtures/units) — plus the polkit agent user unit.
# tools/check proves these files parse; this suite proves they say
# what the system needs them to say, and it proves it hermetically:
# bootkeep runs against a fake /boot and /usr/lib/modules inside a
# mktemp -d sandbox (removed by the trap below), the grub call and
# setup.sh's sudo are PATH shims that record into the sandbox, and the
# configs are read as text — no sudo, no network, no root filesystem
# touched. setup.sh is sourced, not run: its closing BASH_SOURCE guard
# exists precisely so enable_system_units, configure_boot and
# configure_system_services can be exercised alone.
#
# Needs: bash, coreutils, grep, sed, awk. shellcheck (bootkeep's lint)
# and nft + unshare (the ruleset syntax check, run unprivileged in a
# user+net namespace) are optional: a test whose tool is absent prints
# "skip", not "FAIL", so the suite passes on a bare Ubuntu runner.
# shellcheck disable=SC2016  # snippets handed to a fresh bash are meant literally
# shellcheck disable=SC2329  # every t_* function is invoked indirectly, through check's "$@"
# shellcheck disable=SC2317  # the same verdict as shellcheck <= 0.9 (CI's) hands down: per body line, before SC2329 existed
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
REPO_DIR="$PWD"

SANDBOX="$(mktemp -d -t check-system.XXXXXX)"
SANDBOX="$(readlink -f "$SANDBOX")"
trap 'rm -rf "$SANDBOX"' EXIT

failed=0
# check NAME COMMAND... — tools/check's reporter: stdout dropped,
# failures speak on stderr. The test runs as a plain command, not as
# an `if` condition: bash ignores errexit — including a `set -e` the
# function sets itself — for everything called from a condition, and
# every t_* body below relies on its `set -e` to make each line an
# assertion rather than only the last one.
# shellcheck disable=SC2181  # the $? test is the point: `if "$@"` would defeat the bodies' set -e
check() {
    local name="$1"; shift
    "$@" >/dev/null
    if [ $? -eq 0 ]; then
        printf '  ok    %s\n' "$name"
    else
        printf '  FAIL  %s\n' "$name"
        failed=1
    fi
}
skip() {   # skip NAME REASON — the tool the test needs is absent here (a bare CI runner)
    printf '  skip  %s (%s)\n' "$1" "$2"
}
have() { command -v "$1" >/dev/null 2>&1; }
# not COMMAND... — a negated assertion that errexit honours: a bare
# `! cmd` is exempt from set -e, so a wrongly-present file would pass
not() { ! "$@"; }
mkbox() { mktemp -d "$SANDBOX/box.XXXXXX"; }

# with_setup HOMEDIR SNIPPET — check-shell's harness: a fresh bash
# sources setup.sh with HOME boxed, then evals SNIPPET under the
# `set -euo pipefail` setup.sh established. PATH and SHIM_LOG pass
# through the environment, so a test that exported a shim dir first
# has setup.sh's sudo land on the shim.
with_setup() {
    HOME="$1" bash -c 'source "$1/setup.sh" && eval "$2"' check-system "$REPO_DIR" "$2"
}

# shim DIR NAME BODY — a fake NAME for PATH: bootkeep's grub-mkconfig,
# setup.sh's sudo
shim() {
    printf '#!/bin/bash\n%s\n' "$3" > "$1/$2"
    chmod +x "$1/$2"
}

# ini_get FILE SECTION KEY — every value KEY carries inside [SECTION],
# one per line, whitespace around the = and at the ends trimmed. The
# pacman hooks repeat Target=, so a key may answer more than once;
# ini_is wants exactly one value, ini_has any of them.
ini_get() {
    awk -v want="$2" -v key="$3" '
        /^[ \t]*[#;]/ { next }
        /^\[.*\]/ { sec = $0; sub(/^\[/, "", sec); sub(/\].*$/, "", sec); next }
        sec == want && index($0, "=") {
            k = substr($0, 1, index($0, "=") - 1); gsub(/^[ \t]+|[ \t]+$/, "", k)
            if (k != key) next
            v = substr($0, index($0, "=") + 1); gsub(/^[ \t]+|[ \t]+$/, "", v)
            print v
        }' "$1"
}
ini_is()  { [ "$(ini_get "$1" "$2" "$3")" = "$4" ]; }
ini_has() { ini_get "$1" "$2" "$3" | grep -qxF -- "$4"; }

# commented FILE — an INI-ish file explains itself: a # line before
# the first section (the pacman hook parser and systemd both allow it)
commented() { awk '/^\[/ { exit } /^#/ { found = 1 } END { exit !found }' "$1"; }

# ------------------------------------------------------------- bootkeep ---
BOOTKEEP="$REPO_DIR/system/usr/local/bin/bootkeep"

# fake_boot BOX — a /boot with the live linux pair plus the microcode,
# and a modules tree where 7.1.9-arch1-2 belongs to linux and the lts
# kernel to linux-lts, so the pkgbase lookup has a neighbour to get
# wrong. Prints nothing; the caller exports BOOTKEEP_* into it.
fake_boot() {
    mkdir -p "$1/boot" "$1/modules/7.1.9-arch1-2" "$1/modules/6.12.40-1-lts"
    printf 'kernel\n' > "$1/boot/vmlinuz-linux"
    printf 'initrd\n' > "$1/boot/initramfs-linux.img"
    printf 'ucode\n'  > "$1/boot/intel-ucode.img"
    printf 'linux\n'     > "$1/modules/7.1.9-arch1-2/pkgbase"
    printf 'linux-lts\n' > "$1/modules/6.12.40-1-lts/pkgbase"
}
bk() {   # bk BOX SUBCOMMAND... — bootkeep pointed into the box
    local b="$1"; shift
    BOOTKEEP_BOOT="$b/boot" BOOTKEEP_MODULES="$b/modules" BOOTKEEP_BACKUP="$b/backup" \
        BOOTKEEP_KEEP="${KEEP:-2}" "$BOOTKEEP" "$@"
}

t_bootkeep_is_bash() ( set -e
    [ -x "$BOOTKEEP" ]
    head -n1 "$BOOTKEEP" | grep -q bash
    bash -n "$BOOTKEEP"
)

t_bootkeep_usage() ( set -e
    b="$(mkbox)"
    # an unknown word must not fall through to any subcommand: usage on
    # stderr, nothing on stdout, exit 2
    rc=0; out="$(bk "$b" frobnicate 2> "$b/err")" || rc=$?
    [ "$rc" -eq 2 ]
    [ -z "$out" ]
    [ -s "$b/err" ]
)

t_keep_copies_pair() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    touch -d '2026-08-01 12:00:00' "$b/boot/vmlinuz-linux" "$b/boot/initramfs-linux.img"
    printf 'linux\n' | bk "$b" keep
    # GRUB's 10_linux pairs vmlinuz-<version> with initramfs-<version>.img
    # and grub-btrfs takes kversion=${name#*-} then initramfs-$kversion.img:
    # only these exact spellings are found by both
    cmp -s "$b/boot/vmlinuz-linux"        "$b/boot/vmlinuz-linux-7.1.9-arch1-2"
    cmp -s "$b/boot/initramfs-linux.img"  "$b/boot/initramfs-linux-7.1.9-arch1-2.img"
    # the copy keeps the live file's mtime: that stamp is the prune order
    [ "$(stat -c %Y "$b/boot/vmlinuz-linux-7.1.9-arch1-2")" = "$(stat -c %Y "$b/boot/vmlinuz-linux")" ]
    [ "$(stat -c %Y "$b/boot/initramfs-linux-7.1.9-arch1-2.img")" = "$(stat -c %Y "$b/boot/initramfs-linux.img")" ]
    # and nothing was filed under the lts kernel's version
    not [ -e "$b/boot/vmlinuz-linux-6.12.40-1-lts" ]
)

t_keep_names_match_grub() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    printf 'linux\n' | bk "$b" keep
    cd "$b/boot"
    for name in vmlinuz-linux-*; do
        [[ $name =~ ^vmlinuz-(linux-[0-9][^/]*)$ ]]
        kversion="${name#*-}"
        [ "$kversion" = "linux-7.1.9-arch1-2" ]
        [ -f "initramfs-$kversion.img" ]
    done
)

t_keep_live_untouched() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    before="$(cd "$b/boot" && sha256sum vmlinuz-linux initramfs-linux.img intel-ucode.img)"
    printf 'linux\n' | bk "$b" keep
    [ "$(cd "$b/boot" && sha256sum vmlinuz-linux initramfs-linux.img intel-ucode.img)" = "$before" ]
)

t_keep_prunes_to_keep() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    # three upgrades in a row, each a newer kernel: the modules dir is
    # renamed to the next version and the live pair restamped, so the
    # kept pairs differ only in mtime. Two survive, the oldest goes,
    # both files of it.
    for v in 7.1.7-arch1-1 7.1.8-arch1-1 7.1.9-arch1-2; do
        rm -rf "$b/modules"/7.*; mkdir -p "$b/modules/$v"; printf 'linux\n' > "$b/modules/$v/pkgbase"
        touch -d "2026-08-0${v:4:1} 12:00:00" "$b/boot/vmlinuz-linux" "$b/boot/initramfs-linux.img"
        printf 'linux\n' | bk "$b" keep
    done
    not [ -e "$b/boot/vmlinuz-linux-7.1.7-arch1-1" ]
    not [ -e "$b/boot/initramfs-linux-7.1.7-arch1-1.img" ]
    [ -f "$b/boot/vmlinuz-linux-7.1.8-arch1-1" ]
    [ -f "$b/boot/initramfs-linux-7.1.8-arch1-1.img" ]
    [ -f "$b/boot/vmlinuz-linux-7.1.9-arch1-2" ]
    [ -f "$b/boot/initramfs-linux-7.1.9-arch1-2.img" ]
    [ "$(find "$b/boot" -name 'vmlinuz-linux-*' | wc -l)" -eq 2 ]
)

t_keep_prunes_by_mtime_not_name() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    # a version string that sorts later but was built earlier: mtime
    # decides, so the alphabetically-last 7.1.10 (older build) is pruned
    for v in 7.1.10-arch1-1 7.1.8-arch1-1 7.1.9-arch1-2; do
        rm -rf "$b/modules"/7.*; mkdir -p "$b/modules/$v"; printf 'linux\n' > "$b/modules/$v/pkgbase"
        touch -d "2026-08-01 12:0${v:4:1}:00" "$b/boot/vmlinuz-linux" "$b/boot/initramfs-linux.img"
        KEEP=2 printf 'linux\n' | bk "$b" keep
    done
    not [ -e "$b/boot/vmlinuz-linux-7.1.10-arch1-1" ]
    [ -f "$b/boot/vmlinuz-linux-7.1.8-arch1-1" ]
    [ -f "$b/boot/vmlinuz-linux-7.1.9-arch1-2" ]
)

t_keep_honours_keep_env() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    for v in 7.1.7-arch1-1 7.1.8-arch1-1 7.1.9-arch1-2; do
        rm -rf "$b/modules"/7.*; mkdir -p "$b/modules/$v"; printf 'linux\n' > "$b/modules/$v/pkgbase"
        touch -d "2026-08-0${v:4:1} 12:00:00" "$b/boot/vmlinuz-linux" "$b/boot/initramfs-linux.img"
        printf 'linux\n' | KEEP=1 bk "$b" keep
    done
    [ "$(find "$b/boot" -name 'vmlinuz-linux-*' | wc -l)" -eq 1 ]
    [ -f "$b/boot/vmlinuz-linux-7.1.9-arch1-2" ]
)

t_keep_per_package() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    printf 'lts kernel\n' > "$b/boot/vmlinuz-linux-lts"
    printf 'lts initrd\n' > "$b/boot/initramfs-linux-lts.img"
    # both packages on stdin, a blank line between them; each lands
    # under its own kver and the count is per package
    printf 'linux\n\nlinux-lts\n' | bk "$b" keep
    cmp -s "$b/boot/vmlinuz-linux"     "$b/boot/vmlinuz-linux-7.1.9-arch1-2"
    cmp -s "$b/boot/vmlinuz-linux-lts" "$b/boot/vmlinuz-linux-lts-6.12.40-1-lts"
    [ -f "$b/boot/initramfs-linux-lts-6.12.40-1-lts.img" ]
    not [ -e "$b/boot/vmlinuz-linux-lts-7.1.9-arch1-2" ]
)

t_keep_unknown_package() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    before="$(find "$b/boot" | sort)"
    # no vmlinuz-linux-zen, no modules dir naming it: nothing happens,
    # and it is not an error — the hook must not abort the transaction
    printf 'linux-zen\n' | bk "$b" keep
    [ "$(find "$b/boot" | sort)" = "$before" ]
)

t_keep_needs_both_files() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    rm "$b/boot/initramfs-linux.img"
    printf 'linux\n' | bk "$b" keep
    # half a pair is worse than none: GRUB would list an entry that
    # cannot boot
    not [ -e "$b/boot/vmlinuz-linux-7.1.9-arch1-2" ]
)

t_backup_mirrors() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    mkdir "$b/boot/grub"; printf 'cfg\n' > "$b/boot/grub/grub.cfg"
    # the backup dir's parent does not exist yet: created on the way
    BOOTKEEP_BACKUP="$b/deep/backup" BOOTKEEP_BOOT="$b/boot" "$BOOTKEEP" backup
    diff -r "$b/boot" "$b/deep/backup"
    not [ -e "$b/deep/backup.new" ]
)

t_backup_replaces() ( set -e
    b="$(mkbox)"; fake_boot "$b"
    bk "$b" backup
    # a second run mirrors the current state: a file gone from /boot is
    # gone from the mirror too (replace, never merge), and the staging
    # dir is gone with it
    rm "$b/boot/intel-ucode.img"
    printf 'newer\n' > "$b/boot/vmlinuz-linux"
    bk "$b" backup
    diff -r "$b/boot" "$b/backup"
    not [ -e "$b/backup/intel-ucode.img" ]
    not [ -e "$b/backup.new" ]
)

t_backup_no_boot() ( set -e
    b="$(mkbox)"
    # no /boot (a container, a chroot without it mounted): a no-op, not
    # a failed pre-transaction hook
    bk "$b" backup
    not [ -e "$b/backup" ]
)

t_grub_runs_mkconfig() ( set -e
    b="$(mkbox)"; mkdir "$b/bin"
    shim "$b/bin" grub-mkconfig 'printf "%s\n" "$*" > "$SHIM_LOG"'
    PATH="$b/bin:$PATH" SHIM_LOG="$b/log" \
        BOOTKEEP_GRUB_MKCONFIG="grub-mkconfig -o $b/grub.cfg" "$BOOTKEEP" grub
    [ "$(cat "$b/log")" = "-o $b/grub.cfg" ]
)

# --------------------------------------------------------- pacman hooks ---
HOOKS="$REPO_DIR/system/etc/pacman.d/hooks"

t_hook_backup() ( set -e
    f="$HOOKS/00-bootkeep-backup.hook"
    commented "$f"
    ini_is  "$f" Trigger Type Package
    ini_has "$f" Trigger Operation Install
    ini_has "$f" Trigger Operation Upgrade
    ini_has "$f" Trigger Operation Remove
    ini_is  "$f" Trigger Target '*'
    ini_is  "$f" Action When PreTransaction
    ini_is  "$f" Action Exec '/usr/local/bin/bootkeep backup'
)

t_hook_keep() ( set -e
    f="$HOOKS/01-bootkeep-keep.hook"
    commented "$f"
    ini_is  "$f" Trigger Type Package
    ini_is  "$f" Trigger Operation Upgrade
    ini_has "$f" Trigger Target linux
    ini_has "$f" Trigger Target linux-lts
    ini_is  "$f" Action When PreTransaction
    ini_is  "$f" Action Exec '/usr/local/bin/bootkeep keep'
    # the package names arrive on stdin, one per line — that is NeedsTargets
    grep -qx 'NeedsTargets' "$f"
)

t_hook_grub() ( set -e
    f="$HOOKS/zz-bootkeep-grub.hook"
    commented "$f"
    ini_is  "$f" Trigger Type Package
    ini_has "$f" Trigger Operation Install
    ini_has "$f" Trigger Operation Upgrade
    ini_has "$f" Trigger Operation Remove
    ini_has "$f" Trigger Target linux
    ini_has "$f" Trigger Target linux-lts
    ini_is  "$f" Action When PostTransaction
    ini_is  "$f" Action Exec '/usr/local/bin/bootkeep grub'
)

t_hook_order() ( set -e
    # pacman runs hooks in name order: the backup must precede snap-pac's
    # pre snapshot and the grub regen must follow mkinitcpio's install
    [ -f "$HOOKS/00-bootkeep-backup.hook" ]
    [ -f "$HOOKS/zz-bootkeep-grub.hook" ]
    [ "$(printf '%s\n' 05-snap-pac-pre 00-bootkeep-backup | LC_ALL=C sort | head -n1)" = 00-bootkeep-backup ]
    [ "$(printf '%s\n' 90-mkinitcpio-install zz-bootkeep-grub | LC_ALL=C sort | tail -n1)" = zz-bootkeep-grub ]
)

# --------------------------------------------------------------- oomd ---
t_oomd_conf() ( set -e
    f="$REPO_DIR/system/etc/systemd/oomd.conf.d/10-pressure.conf"
    commented "$f"
    ini_is "$f" OOM DefaultMemoryPressureLimit 50%
    ini_is "$f" OOM DefaultMemoryPressureDurationSec 20s
)

t_oomd_user_slice() ( set -e
    f="$REPO_DIR/system/etc/systemd/system/user.slice.d/10-oomd.conf"
    commented "$f"
    ini_is "$f" Slice ManagedOOMMemoryPressure kill
    ini_is "$f" Slice ManagedOOMMemoryPressureLimit 50%
)

# ----------------------------------------------------------- nftables ---
NFT_CONF="$REPO_DIR/system/etc/nftables.conf"

t_nft_shape() ( set -e
    f="$NFT_CONF"
    [ "$(head -n1 "$f")" = '#!/usr/bin/nft -f' ]
    # `flush ruleset` would take Mullvad's `inet mullvad` table down with
    # ours on every reload; only our own table is rebuilt
    not grep -q 'flush ruleset' "$f"
    grep -q '^destroy table inet filter' "$f"
    grep -q '^table inet filter' "$f"
    # the retired tailnet marks table (7389cef) is destroyed, since a
    # reload rebuilds only what the file names, and not rebuilt
    grep -q '^destroy table inet tailnet' "$f"
    not grep -q '^table inet tailnet' "$f"
    grep -Eq 'type filter hook input priority filter; *policy drop;' "$f"
    grep -Eq 'type filter hook forward priority filter; *policy drop;' "$f"
    grep -Eq 'ct state \{ *established, *related *\} accept' "$f"
    grep -Eq 'iif "?lo"? accept' "$f"
    grep -Eq '(meta l4proto|ip protocol) icmp' "$f" || grep -Eq '^\s*icmp ' "$f"
    grep -Eq '(meta l4proto|meta nfproto ipv6 .*) ipv6-icmp|ipv6-icmp ' "$f"
)

t_nft_ssh_tailnet_only() ( set -e
    f="$NFT_CONF"
    # ssh opens to tailscale0 alone: every dport-22 rule names the
    # interface, none stands alone or admits a LAN range
    grep -E 'tcp dport (22|ssh)' "$f" | not grep -Eq -v 'iifname "tailscale0"'
    grep -Eq '^\s*iifname "tailscale0" tcp dport (22|ssh) accept' "$f"
    not grep -Eq 'saddr \{[^}]*(10\.0\.0\.0/8|192\.168\.0\.0/16|fc00::/7)' "$f"
    # tailscaled is set aside (setup.sh, enable_system_units): the port
    # /etc/default/tailscaled names is not open
    port="$(sed -n 's/^PORT="\([0-9]*\)"$/\1/p' "$REPO_DIR/system/etc/default/tailscaled")"
    [ -n "$port" ]
    not grep -Eq "^\s*udp dport $port accept" "$f"
)

t_nft_libvirt() ( set -e
    f="$NFT_CONF"
    # the default network's dnsmasq (DHCP and DNS from the VMs) in
    # input, the VMs' NAT both ways in forward: libvirt's own table
    # adds no input rule and a packet must pass every table
    grep -Eq '^\s*iifname "virbr0" meta l4proto \{ *tcp, *udp *\} th dport \{ *53, *67 *\} accept' "$f"
    fwd="$(sed -n '/chain forward/,/^  }/p' "$f")"
    grep -Eq 'ct state \{ *established, *related *\} accept' <<<"$fwd"
    grep -Eq '^\s*iifname "virbr0" accept' <<<"$fwd"
    grep -Eq '^\s*oifname "virbr0" accept' <<<"$fwd"
)

t_nft_syntax() ( set -e
    # nft -c parses and resolves without touching any ruleset; inside a
    # fresh user+net namespace it needs no privilege
    unshare -rn nft -c -f "$NFT_CONF"
)

# ---------------------------------------------------------------- sshd ---
t_sshd_keys_only() ( set -e
    f="$REPO_DIR/system/etc/ssh/sshd_config.d/10-keys-only.conf"
    [ "$(head -c1 "$f")" = '#' ]
    grep -Eiq '^\s*PasswordAuthentication\s+no\s*$' "$f"
    grep -Eiq '^\s*PermitRootLogin\s+no\s*$' "$f"
    grep -Eiq '^\s*AuthenticationMethods\s+publickey\s*$' "$f"
    grep -Eiq '^\s*AllowGroups\s+wheel\s*$' "$f"
)

# ------------------------------------------------------- NetworkManager ---
t_nm_privacy() ( set -e
    f="$REPO_DIR/system/etc/NetworkManager/conf.d/10-privacy.conf"
    commented "$f"
    ini_is "$f" main dns systemd-resolved
    ini_is "$f" connection wifi.cloned-mac-address stable
    ini_is "$f" connection ethernet.cloned-mac-address stable
    ini_is "$f" connection ipv6.ip6-privacy 2
    ini_is "$f" connection connection.llmnr 0
    ini_is "$f" connection connection.mdns 0
    ini_is "$f" connection ipv4.dhcp-send-hostname 0
    ini_is "$f" connection ipv6.dhcp-send-hostname 0
    ini_is "$f" connection ipv6.dhcp-duid stable-uuid
    ini_is "$f" device wifi.scan-rand-mac-address yes
)

# ------------------------------------------------------------ resolved ---
t_resolved_dns() ( set -e
    f="$REPO_DIR/system/etc/systemd/resolved.conf.d/10-dns.conf"
    commented "$f"
    # an empty FallbackDNS= is the point: no silent drop to Cloudflare/Google
    grep -Eq '^\s*FallbackDNS\s*=\s*$' "$f"
    ini_is "$f" Resolve MulticastDNS no
    ini_is "$f" Resolve LLMNR no
    # no global resolver, no "~." route, no strict DoT: the tunnel's own
    # resolver rules when up, the link's when down (an ISP that blackholes
    # 853 made a global Mullvad pin mean "no DNS with the VPN off")
    [ -z "$(ini_get "$f" Resolve DNS)" ]
    [ -z "$(ini_get "$f" Resolve Domains)" ]
    [ -z "$(ini_get "$f" Resolve DNSOverTLS)" ]
)

# ------------------------------------------------------------ faillock ---
t_faillock() ( set -e
    f="$REPO_DIR/system/etc/security/faillock.conf"
    [ "$(head -c1 "$f")" = '#' ]
    grep -Eq '^\s*deny\s*=\s*5\s*$' "$f"
    grep -Eq '^\s*fail_interval\s*=\s*900\s*$' "$f"
    grep -Eq '^\s*unlock_time\s*=\s*120\s*$' "$f"
)

# ----------------------------------------------------------------- tlp ---
t_tlp_battery() ( set -e
    f="$REPO_DIR/system/etc/tlp.d/10-battery.conf"
    [ "$(head -c1 "$f")" = '#' ]
    grep -Eq '^\s*START_CHARGE_THRESH_BAT0\s*=\s*"?0"?\s*$' "$f"
    grep -Eq '^\s*STOP_CHARGE_THRESH_BAT0\s*=\s*"?1"?\s*$' "$f"
)

# ----------------------------------------------------------- bluetooth ---
t_bluetooth() ( set -e
    f="$REPO_DIR/system/etc/bluetooth/main.conf"
    commented "$f"
    ini_is "$f" Policy AutoEnable false
    ini_is "$f" General Privacy device
)

# -------------------------------------------------------------- sysctl ---
t_sysctl() ( set -e
    f="$REPO_DIR/system/etc/sysctl.d/50-hardening.conf"
    [ "$(head -c1 "$f")" = '#' ]
    is() { grep -Eq "^\s*$1\s*=\s*$2\s*$" "$f"; }
    is kernel.kptr_restrict 1
    is kernel.kexec_load_disabled 1
    is dev.tty.ldisc_autoload 0
    is fs.protected_fifos 2
    is fs.protected_regular 2
    is net.core.bpf_jit_harden 1
    is vm.mmap_rnd_bits 32
    is vm.mmap_rnd_compat_bits 16
    is net.ipv4.tcp_rfc1337 1
    # IPv4 redirects: all, default and every interface (the kernel
    # ORs all with the interface); IPv6: default and the interfaces,
    # all excluded (the kernel reads the interface alone) so a
    # sysctl --system run stays clean of a key it would only ignore
    for k in accept_redirects secure_redirects send_redirects; do
        for scope in all default '\*'; do is "net\.ipv4\.conf\.$scope\.$k" 0; done
    done
    is 'net\.ipv6\.conf\.default\.accept_redirects' 0
    is 'net\.ipv6\.conf\.\*\.accept_redirects' 0
    grep -Eq '^-net\.ipv6\.conf\.all\.accept_redirects\s*$' "$f"
    # what the header promises stays out
    for k in kernel.unprivileged_userns_clone kernel.sysrq kernel.yama.ptrace_scope net.ipv4.tcp_timestamps log_martians rp_filter; do
        not grep -Eq "^\s*[^#]*$k" "$f"
    done
)

# ------------------------------------------------------------ modprobe ---
t_modprobe() ( set -e
    f="$REPO_DIR/system/etc/modprobe.d/hardening.conf"
    [ "$(head -c1 "$f")" = '#' ]
    # every directive is one of the two the header describes
    grep -v '^#' "$f" | grep -v '^$' | not grep -Eqv '^(install [a-z0-9_-]+ /bin/false|blacklist [a-z0-9_-]+)$'
    for m in sctp rds tipc n-hdlc atm can firewire-core floppy vivid gfs2 cramfs jffs2 hfs hfsplus; do
        grep -Eq "^install $m /bin/false$" "$f"
    done
    for m in squashfs udf cifs nfs nfsv3 nfsv4; do
        grep -Eq "^blacklist $m$" "$f"
    done
    # the modules in use here, and ksmbd, whose softdeps make an
    # install rule a no-op (modprobe.d(5)), never appear as a directive
    for m in thunderbolt bluetooth btusb usb_storage usb-storage uas ksmbd; do
        not grep -Eq "^(install|blacklist) $m\b" "$f"
    done
)

# ------------------------------------------------- coredump, journald ---
t_coredump_storage() ( set -e
    f="$REPO_DIR/system/etc/systemd/coredump.conf.d/10-storage.conf"
    commented "$f"
    ini_is "$f" Coredump Storage none
    # the backtrace still needs the core to arrive
    [ -z "$(ini_get "$f" Coredump ProcessSizeMax)" ]
)

t_journald_size() ( set -e
    f="$REPO_DIR/system/etc/systemd/journald.conf.d/10-size.conf"
    commented "$f"
    ini_is "$f" Journal SystemMaxUse 1G
)

# ------------------------------------------------------------ tmpfiles ---
t_tmpfiles_boot() ( set -e
    f="$REPO_DIR/system/etc/tmpfiles.d/boot.conf"
    [ "$(head -c1 "$f")" = '#' ]
    # z adjusts what exists and creates nothing; 0700 root
    grep -v '^#' "$f" | grep -v '^$' | not grep -Eqv '^z /boot 0700 root root -$'
    grep -Eq '^z /boot 0700 root root -$' "$f"
)

# ------------------------------------------------------------- sudoers ---
SUDOERS="$REPO_DIR/system/etc/sudoers.d/10-hardening"

t_sudoers_editor() ( set -e
    f="$SUDOERS"
    [ "$(head -c1 "$f")" = '#' ]
    grep -Eq '^Defaults\s+!env_editor\s*$' "$f"
    grep -Eq '^Defaults\s+editor=/usr/bin/micro:/usr/bin/vim\s*$' "$f"
    # a file sudo would skip (a dot or ~ in the name) is no policy at all
    case "$(basename "$f")" in *.*|*~*) exit 1 ;; esac
)

t_sudoers_parses() ( set -e
    visudo -cf "$SUDOERS" > /dev/null
)

# ----------------------------------------------------------- tailscaled ---
t_tailscaled_default() ( set -e
    f="$REPO_DIR/system/etc/default/tailscaled"
    [ "$(head -c1 "$f")" = '#' ]
    grep -Eq '^PORT="41641"$' "$f"
    grep -Eq '^FLAGS="--no-logs-no-support"$' "$f"
    # the unit reads it as an EnvironmentFile: two assignments, nothing else
    [ "$(grep -cv '^#' "$f")" -eq 2 ]
)

# --------------------------------------------------------- polkit agent ---
t_polkit_agent_unit() ( set -e
    f="$REPO_DIR/config/systemd/user/polkit-agent.service"
    # asserted as text: systemd-analyze verify would want the binary,
    # which a runner without polkit-gnome does not have
    ini_is "$f" Service ExecStart /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
    ini_is "$f" Service Restart on-failure
    ini_is "$f" Unit PartOf graphical-session.target
    ini_is "$f" Unit Requisite graphical-session.target
    ini_is "$f" Unit After graphical-session.target
    ini_is "$f" Install WantedBy graphical-session.target
)

# ------------------------------------------------------------- setup.sh ---
SETUP="$REPO_DIR/setup.sh"

t_setup_session_units() ( set -e
    b="$(mkbox)"
    with_setup "$b" '
        printf "%s\n" "${SESSION_UNITS[@]}" | grep -qxF polkit-agent.service'
)

t_setup_packages() ( set -e
    # the one pacman transaction: from `sudo pacman -Syu` to its first
    # blank line, every name the new layer needs
    pkgs="$(sed -n '/sudo pacman -Syu/,/^$/p' "$SETUP" | sed 's/\\$//' | tr -s ' \n' '\n')"
    for p in thermald nftables openssh tailscale polkit-gnome bluez bluez-utils bluetui \
             tesseract tesseract-data-eng gpu-screen-recorder; do
        grep -qxF "$p" <<<"$pkgs"
    done
)

t_setup_functions_exist() ( set -e
    b="$(mkbox)"
    with_setup "$b" '
        declare -F enable_system_units > /dev/null
        declare -F apply_nm_privacy > /dev/null
        declare -F configure_system_services > /dev/null'
)

t_setup_enable_units_text() ( set -e
    body="$(sed -n '/^enable_system_units()/,/^}/p' "$SETUP")"
    [ -n "$body" ]
    for unit in systemd-oomd nftables systemd-resolved bluetooth thermald tlp paccache.timer sshd; do
        grep -Eq "systemctl enable[^|]*\b$unit\b" <<<"$body"
    done
    not grep -Eq 'systemctl disable' <<<"$body"
    # tailscaled is set aside: installed, neither enabled nor started
    not grep -Eq '^[^#]*\btailscaled\b' <<<"$body"
    # sshd starts after the firewall and the drop-in are in place
    # (configure_system_services), not here
    not grep -Eq 'systemctl (start|enable --now)[^|]*\bsshd\b' <<<"$body"
    # resolved's stub is the resolver: the symlink NetworkManager's
    # dns=systemd-resolved expects
    grep -Eq 'ln -sf? .*/run/systemd/resolve/stub-resolv.conf +/etc/resolv.conf' <<<"$body"
)

t_setup_configure_boot_text() ( set -e
    body="$(sed -n '/^configure_boot()/,/^}/p' "$SETUP")"
    grep -q 'system_changed_under /etc/pacman.d/hooks' <<<"$body"
    grep -q 'bootkeep backup' <<<"$body"
    grep -q 'bootkeep keep' <<<"$body"
    # a hook change regenerates grub.cfg so the kept pairs show as entries
    hooks_branch="$(sed -n '/system_changed_under \/etc\/pacman.d\/hooks/,/fi/p' <<<"$body")"
    grep -q 'grub-mkconfig -o /boot/grub/grub.cfg' <<<"$hooks_branch"
    # a modprobe.d change is packed into the initramfs by the modconf hook
    initramfs_branch="$(sed -n '/system_changed_under \/etc\/mkinitcpio.conf.d/,/fi/p' <<<"$body")"
    grep -q 'system_changed_under /etc/modprobe.d' <<<"$initramfs_branch"
    grep -q 'mkinitcpio -P' <<<"$initramfs_branch"
)

# install_system_files against the sudo shim: the log holds every
# install call with its mode, so the mode table is proven on the
# repo's own tree. A cmp shim that never matches keeps the real /etc
# out of the decision: a file already installed here would otherwise
# be skipped, and a runner has none of them
t_setup_install_modes() ( set -e
    b="$(mkbox)"; mkdir "$b/bin"
    shim "$b/bin" sudo "$SUDO_SHIM"
    shim "$b/bin" cmp 'exit 1'
    log="$(PATH="$b/bin:$PATH" SHIM_LOG="$b/log" with_setup "$b" '
        install_system_files > /dev/null' && cat "$b/log")"
    grep -Eq '^install -D -m 440 .*/system/etc/sudoers.d/10-hardening /etc/sudoers.d/10-hardening$' <<<"$log"
    grep -Eq '^install -D -m 644 .*/system/etc/sysctl.d/50-hardening.conf /etc/sysctl.d/50-hardening.conf$' <<<"$log"
    grep -Eq '^install -D -m 755 .*/system/usr/local/bin/bootkeep /usr/local/bin/bootkeep$' <<<"$log"
    not grep -Eq '^install -D -m (440|600) ' <<<"$(grep -v sudoers.d <<<"$log")"
)

t_setup_sudoers_gate() ( set -e
    # an unparsable sudoers file is refused before install: the shim
    # log must not show it, and the function must fail
    b="$(mkbox)"; mkdir "$b/bin" "$b/repo"
    shim "$b/bin" sudo "$SUDO_SHIM"
    cp -r "$REPO_DIR/setup.sh" "$b/repo/"
    mkdir -p "$b/repo/system/etc/sudoers.d"
    printf 'Defaults editor=\n' > "$b/repo/system/etc/sudoers.d/10-broken"
    not env PATH="$b/bin:$PATH" SHIM_LOG="$b/log" HOME="$b" \
        bash -c 'source "$1/setup.sh" && install_system_files' check-system "$b/repo" 2>/dev/null
    not grep -q sudoers.d "$b/log" 2>/dev/null
)

# the sudo shim logs its argv; configure_system_services must reach
# every privileged call through sudo, so the log is the whole decision
SUDO_SHIM='printf "%s\n" "$*" >> "$SHIM_LOG"; exit 0'

# services_after CHANGED... — run configure_system_services with the
# given SYSTEM_CHANGED and print the sudo log; a function that is
# missing or fails is the caller's failure, not an empty log
services_after() {
    local b; b="$(mkbox)"; mkdir "$b/bin"
    shim "$b/bin" sudo "$SUDO_SHIM"
    PATH="$b/bin:$PATH" SHIM_LOG="$b/log" with_setup "$b" "
        SYSTEM_CHANGED=($*)
        configure_system_services > /dev/null" || return 1
    cat "$b/log" 2>/dev/null || true
}

t_services_nftables() ( set -e
    log="$(services_after /etc/nftables.conf)"
    grep -Eq '^systemctl (restart|reload) nftables$' <<<"$log"
    not grep -q resolved <<<"$log"
    not grep -q tlp <<<"$log"
)

t_services_resolved() ( set -e
    log="$(services_after /etc/systemd/resolved.conf.d/10-dns.conf)"
    grep -Eq '^systemctl restart systemd-resolved$' <<<"$log"
    not grep -q nftables <<<"$log"
    not grep -q tlp <<<"$log"
)

t_services_tlp() ( set -e
    log="$(services_after /etc/tlp.d/10-battery.conf)"
    grep -Eq '^tlp start$' <<<"$log"
    not grep -q nftables <<<"$log"
    not grep -q resolved <<<"$log"
)

# what a quiet rerun still does: sshd runs
QUIET_RERUN='systemctl start sshd'

t_services_nothing() ( set -e
    log="$(services_after)"
    [ "$log" = "$QUIET_RERUN" ]
)

t_services_tailscaled_aside() ( set -e
    # a rerun neither starts tailscaled nor touches its preferences,
    # and no code line of setup.sh calls the tailscale CLI
    log="$(services_after)"
    not grep -q tailscale <<<"$log"
    not grep -Eq '^[^#]*\btailscale (set|up|down|login|logout)\b' "$SETUP"
    # the re-enable instructions keep the flag on the login command:
    # the first `tailscale up` rebuilds the preferences from its flags
    # (the 2026-09-01 outage), so a bare `sudo tailscale up` is wrong
    grep -q 'tailscale up --netfilter-mode=off' "$SETUP"
    grep -q 'tailscale up --netfilter-mode=off' "$REPO_DIR/CLAUDE.md"
    not grep -Eq 'sudo tailscale up(`| *$)' "$SETUP" "$REPO_DIR/CLAUDE.md"
)

t_services_sysctl() ( set -e
    log="$(services_after /etc/sysctl.d/50-hardening.conf)"
    grep -Eq '^systemctl restart systemd-sysctl$' <<<"$log"
    not grep -q nftables <<<"$log"
)

t_services_journald() ( set -e
    log="$(services_after /etc/systemd/journald.conf.d/10-size.conf)"
    grep -Eq '^systemctl reload systemd-journald$' <<<"$log"
    not grep -q 'restart systemd-journald' <<<"$log"
)

t_services_tmpfiles() ( set -e
    log="$(services_after /etc/tmpfiles.d/boot.conf)"
    grep -Eq '^systemd-tmpfiles --create /etc/tmpfiles.d/boot.conf$' <<<"$log"
)

t_services_sshd() ( set -e
    # sshd -t stands before the reload, and a failed check stops it
    log="$(services_after /etc/ssh/sshd_config.d/10-keys-only.conf)"
    grep -Eq '^sshd -t$' <<<"$log"
    grep -Eq '^systemctl reload-or-restart sshd$' <<<"$log"
    [ "$(grep -n 'sshd -t' <<<"$log" | cut -d: -f1)" -lt "$(grep -n 'reload-or-restart sshd' <<<"$log" | cut -d: -f1)" ]
    b="$(mkbox)"; mkdir "$b/bin"
    shim "$b/bin" sudo 'printf "%s\n" "$*" >> "$SHIM_LOG"; [ "$1" = sshd ] && exit 1; exit 0'
    not env PATH="$b/bin:$PATH" SHIM_LOG="$b/log" HOME="$b" \
        bash -c 'source "$1/setup.sh" && SYSTEM_CHANGED=(/etc/ssh/sshd_config.d/10-keys-only.conf) && configure_system_services' check-system "$REPO_DIR" 2>/dev/null
    not grep -q 'reload-or-restart sshd' "$b/log"
)

t_services_tailscaled() ( set -e
    log="$(services_after /etc/default/tailscaled)"
    # try-restart: a changed environment file reaches a running
    # daemon, a disabled one stays down
    grep -Eq '^systemctl try-restart tailscaled$' <<<"$log"
    not grep -Eq '^systemctl restart tailscaled$' <<<"$log"
    not grep -q sshd_config <<<"$log"
)

t_services_coredump_quiet() ( set -e
    # systemd-coredump reads its config at each crash: no trigger
    log="$(services_after /etc/systemd/coredump.conf.d/10-storage.conf)"
    [ "$log" = "$QUIET_RERUN" ]
)

# --------------------------------------------------- service boundaries ---
# The drop-ins are asserted as text on the lines that carry the
# decisions (the ones a later "tidy-up" would be tempted to change):
# each unit's capability set, its device nodes, the paths and socket
# families it keeps, and the syscall set. The score row proves the
# whole file, through systemd-analyze against the vendored unit files.
LAYER="$REPO_DIR/system/etc/systemd/system"
SANDBOX_CHECK="$REPO_DIR/tools/sandbox-check"
boundary() { echo "$LAYER/$1.service.d/hardening.conf"; }
# namespace_free FILE — no directive that would put the unit in a
# private mount namespace (systemd.exec: mounts made inside never
# reach the host), for the two units that mount for the host
namespace_free() {
    local key
    for key in ProtectSystem ProtectHome PrivateTmp PrivateDevices PrivateMounts PrivateNetwork \
               ProtectKernelTunables ProtectKernelModules ProtectKernelLogs ProtectControlGroups \
               ProtectProc ProcSubset ReadWritePaths ReadOnlyPaths InaccessiblePaths BindPaths \
               BindReadOnlyPaths TemporaryFileSystem RootDirectory MountAPIVFS; do
        [ -z "$(ini_get "$1" Service "$key")" ] || return 1
    done
}

t_boundary_wpa_supplicant() ( set -e
    f="$(boundary wpa_supplicant)"
    commented "$f"
    ini_is "$f" Service CapabilityBoundingSet 'CAP_NET_ADMIN CAP_NET_RAW'
    ini_is "$f" Service RuntimeDirectory wpa_supplicant
    ini_is "$f" Service ProtectSystem strict
    ini_is "$f" Service DevicePolicy closed
    ini_is "$f" Service DeviceAllow '/dev/rfkill r'          # read-only: NetworkManager does the writes
    ini_is "$f" Service ProtectKernelTunables yes
    ini_is "$f" Service ReadWritePaths /proc/sys/net          # its own per-interface knobs
    ini_is "$f" Service RestrictAddressFamilies 'AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6'
    ini_is "$f" Service IPAddressDeny any                     # no IP traffic of its own
    ini_is "$f" Service SystemCallFilter @system-service
    [ -z "$(ini_get "$f" Service PrivateDevices)" ]           # would hide /dev/rfkill
)

t_boundary_mullvad_daemon() ( set -e
    f="$(boundary mullvad-daemon)"
    commented "$f"
    ini_is "$f" Unit Wants mullvad-net-cls.service
    ini_is "$f" Unit After mullvad-net-cls.service
    ini_is "$f" Service CapabilityBoundingSet 'CAP_NET_ADMIN CAP_NET_RAW'   # no CAP_SYS_ADMIN: the oneshot mounts
    ini_is "$f" Service ExecStartPre '+/usr/bin/mkdir -p /sys/fs/cgroup/net_cls/mullvad-exclusions'  # full privileges: the v1 root is 555 too
    ini_is "$f" Service ProtectSystem strict
    ini_is "$f" Service ConfigurationDirectory mullvad-vpn   # created before the namespace: a deleted
    ini_is "$f" Service LogsDirectory mullvad-vpn             # dir must not fail the start (the cgroup
    ini_is "$f" Service CacheDirectory mullvad-vpn            # path below says the same with its dash)
    ini_has "$f" Service ReadWritePaths /run
    ini_has "$f" Service ReadWritePaths /proc/sys/net
    ini_has "$f" Service ReadWritePaths -/sys/fs/cgroup/net_cls  # dash: a missing hierarchy degrades split tunnelling, never the start
    ini_is "$f" Service ProtectControlGroups yes              # strict/private would lose the net_cls submount
    ini_is "$f" Service DevicePolicy closed
    ini_is "$f" Service DeviceAllow '/dev/net/tun rw'
    ini_is "$f" Service RestrictAddressFamilies 'AF_UNIX AF_NETLINK AF_INET AF_INET6'
    ini_is "$f" Service SystemCallFilter @system-service       # no @mount
    ini_is "$f" Service SystemCallErrorNumber EPERM            # a miss must not become a restart loop
)

t_boundary_mullvad_early_boot() ( set -e
    f="$(boundary mullvad-early-boot-blocking)"
    commented "$f"
    ini_is "$f" Service CapabilityBoundingSet CAP_NET_ADMIN
    ini_is "$f" Service PrivateDevices yes
    ini_is "$f" Service ProtectControlGroups strict
    ini_is "$f" Service LogsDirectory mullvad-vpn             # the Blocked policy writes no sysctl
    ini_is "$f" Service RestrictAddressFamilies 'AF_UNIX AF_NETLINK'
    ini_is "$f" Service IPAddressDeny any
    ini_is "$f" Service SystemCallFilter @system-service
)

t_boundary_net_cls_unit() ( set -e
    f="$LAYER/mullvad-net-cls.service"
    commented "$f"
    ini_is "$f" Unit ConditionPathIsMountPoint '!/sys/fs/cgroup/net_cls'
    ini_is "$f" Service Type oneshot
    ini_is "$f" Service RemainAfterExit yes
    ini_has "$f" Service ExecStart '/usr/bin/mkdir -p /sys/fs/cgroup/net_cls'
    ini_has "$f" Service ExecStart '/usr/bin/mount -t cgroup -o net_cls net_cls /sys/fs/cgroup/net_cls'
    ini_is "$f" Service CapabilityBoundingSet 'CAP_SYS_ADMIN CAP_DAC_OVERRIDE'  # the cgroup2 root is mode 555
    ini_is "$f" Service SystemCallFilter '@system-service @mount'
    namespace_free "$f"                                        # its mount must reach the host
    not grep -q '^\[Install\]' "$f"                            # pulled in by the daemon's Wants=, never enabled
)

t_boundary_thermald() ( set -e
    f="$(boundary thermald)"
    commented "$f"
    ini_is "$f" Service CapabilityBoundingSet CAP_SYS_BOOT     # the CRITICAL-trip poweroff
    ini_is "$f" Service SystemCallFilter '@system-service @reboot'
    ini_is "$f" Service RuntimeDirectory thermald
    ini_is "$f" Service RuntimeDirectoryPreserve yes
    ini_is "$f" Service ProtectSystem strict
    ini_is "$f" Service ReadOnlyPaths /proc/sys
    [ -z "$(ini_get "$f" Service ProtectKernelTunables)" ]    # /sys must stay writable: that is its job
    ini_is "$f" Service DevicePolicy closed
    ini_has "$f" Service DeviceAllow '/dev/acpi_thermal_rel rw'
    ini_has "$f" Service DeviceAllow 'char-input r'
    ini_is "$f" Service RestrictAddressFamilies 'AF_UNIX AF_NETLINK'   # uevents, or it goes quiet
    ini_is "$f" Service IPAddressDeny any
)

t_boundary_grub_btrfsd() ( set -e
    f="$(boundary grub-btrfsd)"
    commented "$f"
    ini_is "$f" Service CapabilityBoundingSet CAP_SYS_ADMIN
    ini_is "$f" Service ReadWritePaths /boot/grub
    ini_is "$f" Service PrivateTmp yes                         # the script's mount point lives there
    ini_is "$f" Service PrivateNetwork yes
    ini_is "$f" Service DevicePolicy closed
    ini_has "$f" Service DeviceAllow 'block-device-mapper r'
    ini_has "$f" Service DeviceAllow 'block-blkext r'
    ini_has "$f" Service DeviceAllow '/dev/mapper/control rw'  # grub-probe on a dm-crypt root
    ini_is "$f" Service SystemCallFilter '@system-service @mount'
)

t_boundary_udisks2() ( set -e
    f="$(boundary udisks2)"
    commented "$f"
    namespace_free "$f"                                        # it mounts for the desktop
    [ -z "$(ini_get "$f" Service ProtectClock)" ]             # its implied DeviceAllow would cut the disks off
    caps="$(ini_get "$f" Service CapabilityBoundingSet)"
    grep -qw CAP_SYS_ADMIN <<<"$caps"
    grep -qw CAP_SYS_MODULE <<<"$caps"
    not grep -qw CAP_KILL <<<"$caps"
    ini_is "$f" Service NoNewPrivileges yes
    ini_is "$f" Service RestrictAddressFamilies 'AF_UNIX AF_NETLINK'
    ini_is "$f" Service SystemCallFilter '@system-service @mount @module @swap'
    ini_is "$f" Service SystemCallErrorNumber EPERM
)

t_boundary_scores() ( set -e
    "$SANDBOX_CHECK" score
)

t_sandbox_render() ( set -e
    # learning mode: the filter becomes a log of the same set, the
    # errno goes, nothing else moves
    rendered="$("$SANDBOX_CHECK" render udisks2)"
    grep -qxF 'SystemCallLog=~@system-service @mount @module @swap' <<<"$rendered"
    not grep -q '^SystemCallFilter=' <<<"$rendered"
    not grep -q '^SystemCallErrorNumber=' <<<"$rendered"
    diff <(grep -vE '^SystemCall(Filter|ErrorNumber)=' "$(boundary udisks2)") \
         <(grep -v '^SystemCallLog=' <<<"$rendered")
    not "$SANDBOX_CHECK" render mullvad-net-cls 2>/dev/null   # a whole unit has nothing to render
)

t_services_boundary_restart() ( set -e
    log="$(services_after /etc/systemd/system/thermald.service.d/hardening.conf)"
    grep -Eq '^systemctl daemon-reload$' <<<"$log"
    grep -Eq '^systemctl try-restart thermald$' <<<"$log"
    not grep -q wpa_supplicant <<<"$log"
)

t_services_boundary_boot_units() ( set -e
    # the early blocker would cut the live tunnel if rerun; the oneshot
    # is the daemon's to pull in: a reload, no restart
    log="$(services_after /etc/systemd/system/mullvad-early-boot-blocking.service.d/hardening.conf \
                          /etc/systemd/system/mullvad-net-cls.service)"
    grep -Eq '^systemctl daemon-reload$' <<<"$log"
    not grep -q restart <<<"$log"
)


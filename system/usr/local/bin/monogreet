#!/usr/bin/env python3
"""monogreet — the login page in the lock screen's image.

A greetd greeter (greetd-ipc(7)) drawn like config/hypr/hyprlock.conf:
the 300px ring on the glass wallpaper, the hour inside, the password
typed into the ring — hidden, as the lock hides it: each keystroke
lights one quadrant of the ring, a random one, never the same twice
running, held until the next keystroke, none while nothing is typed —
and one line under it: the user, then the session and the layout, the
session only when there is a choice to make (one session: nothing to
say; one layout: no mark). The field — ring, glass disc, quadrant — is
not there until the first keystroke, stays while something is typed
or checked, and goes two seconds after the field empties again, as
hyprlock's fade_on_empty has it; the hour stays throughout, the check
included — while the password is checked the ring is lit e8e8e8, and
that is all that says so, as on the lock: the edge moves from its rest
grey to the lit over 800 ms as the check begins and back over 800 ms
when the verdict lands, hyprlock's inputFieldColors animation, so a
refused password is the ring lit and fading back, then the field going
two seconds on. Caps lock and a wrong
password are said in words, on a line under the name, in the name's
size — "caps lock" while it is on, "wrong password" for two
seconds or until the next keystroke, hyprlock's own fail convention
(general:fail_timeout, which the lock's line keeps too, bin/lock-line)
— and neither is painted on the ring, which has no colour but its rest
grey and the check's lit.

Keys: type and Enter to log in; Up/Down cycle users, Tab cycles
sessions, Alt+Shift cycles layouts (the compositor's bind); F10 powers
off, F11 reboots; Esc clears what was typed. The mouse reaches the same:
a word on the line cycles its choice on click — and only a word with a
choice behind it lights under the pointer — the two glyphs at the bottom
power off and reboot.

Runs fullscreen under the greeter niri (system/etc/greetd/niri.kdl),
which supplies the layout list and its switch events over niri's IPC —
no NIRI_SOCKET, no layout mark. Remembers the last user and session in
/var/lib/monogreet/state.json. greetd does the authentication; this
program only relays its prompts and the answers.
"""

import json
import math
import os
import pwd
import random
import shlex
import socket
import struct
import subprocess
import sys
import threading
import queue
import configparser
from datetime import datetime
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gsk", "4.0")
gi.require_version("Graphene", "1.0")
from gi.repository import GLib, Gdk, Gsk, Graphene, Gtk, Pango  # noqa: E402

BACKGROUND = Path("/usr/share/backgrounds/greeter.jpg")
STATE_FILE = Path("/var/lib/monogreet/state.json")
SESSION_DIRS = [Path("/usr/share/wayland-sessions"), Path("/usr/share/xsessions")]
FONT = "JetBrainsMono Nerd Font"

# the palette of config/waybar/style.css and config/hypr/hyprlock.conf
GROUND = (0x0D / 255, 0x0D / 255, 0x0D / 255)
REST = (0xC0 / 255, 0xC0 / 255, 0xC0 / 255)
LIT = (0xE8 / 255, 0xE8 / 255, 0xE8 / 255)
EDGE = (0x33 / 255, 0x33 / 255, 0x33 / 255)
MUTED = (0x66 / 255, 0x66 / 255, 0x66 / 255)

# The lock's units. Every length here is in the output's own pixels, as
# on the lock and the boot splash: hyprlock draws its widgets in the lock
# surface's buffer pixels whatever the compositor's scale (a 294 + 3 ring
# is 300 physical px on a 1920x1080 panel at scale 1.25, not 375), and
# plymouth paints the framebuffer. The page undoes the scale GTK would
# apply (do_snapshot) so the three rings are one size on the same panel.
# Text sizes are hyprlock's font_size numbers, which pango reads as
# points at 96 dpi: 60 is an 80px hour, 16 a 21.3px line.
POINT = 96 / 72               # output pixels per point
RING_RADIUS = 150             # the 3px edge lies within it
RING_WIDTH = 3
LINE_Y = RING_RADIUS + 35     # centre to the line under the ring, as on the lock
MARGIN = 36                   # screen edge to the date's and the glyphs' centre
POWER_GLYPH = "\U000F0425"    # nf-md-power
REBOOT_GLYPH = "\U000F0709"   # nf-md-restart

# the field's coming and going, hyprlock's fade_on_empty by its numbers:
# fade_timeout, and the inputFieldFade animation — speed 8 (× 100 ms) on
# hyprutils' "default" curve, cubic-bezier(0, 0.75, 0.15, 1)
FADE_TIMEOUT_MS = 2000
FADE_MS = 800
# how long "wrong password" stands: hyprlock's general:fail_timeout,
# cleared sooner by the next keystroke, as hyprlock clears its own fail
FAIL_TIMEOUT_MS = 2000
FADE_CURVE = ((0.0, 0.75), (0.15, 1.0))
# the edge's move between rest grey and the check's lit: hyprlock's
# inputFieldColors animation — speed 8 (× 100 ms) on the linear curve,
# hyprlock's own default, written out in hyprlock.conf because this
# page copies it — with the colour lerped in OkLab, as hyprlock's
# animation manager lerps the field's colours (updateGradientVariable)
COLOR_MS = 800


def ease(x, curve=FADE_CURVE):
    """y of the cubic bezier from (0, 0) through the curve's two control
    points to (1, 1) at x in 0..1 — solved for t by bisection (x(t) is
    monotone with both control x's in 0..1), rather than read off a
    lookup table as hyprutils does."""
    (x1, y1), (x2, y2) = curve

    def at(t, p1, p2):
        return 3 * (1 - t) ** 2 * t * p1 + 3 * (1 - t) * t ** 2 * p2 + t ** 3

    low, high = 0.0, 1.0
    for _ in range(40):
        mid = (low + high) / 2
        if at(mid, x1, x2) < x:
            low = mid
        else:
            high = mid
    return at((low + high) / 2, y1, y2)


def oklab_lerp(one, two, progress):
    """The colour progress of the way from one to two with the lerp taken
    in OkLab, as hyprlock's animation manager moves the field's colours
    (hyprgraphics' sRGB ↔ OkLab, Ottosson's matrices) — between two
    greys, as here, that is a move in L alone, the cube root of the
    linear luminance — and back to sRGB, clamped."""
    def to_linear(v):
        return v / 12.92 if v < 0.04045 else ((v + 0.055) / 1.055) ** 2.4

    def to_srgb(v):
        v = min(1.0, max(0.0, v))
        return 12.92 * v if v < 0.0031308 else 1.055 * v ** (1 / 2.4) - 0.055

    def to_oklab(color):
        r, g, b = (to_linear(v) for v in color)
        l = math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
        m = math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
        s = math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
        return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
                1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
                0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)

    def from_oklab(lab):
        big_l, a, b = lab
        l = (big_l + 0.3963377774 * a + 0.2158037573 * b) ** 3
        m = (big_l - 0.1055613458 * a - 0.0638541728 * b) ** 3
        s = (big_l - 0.0894841775 * a - 1.2914855480 * b) ** 3
        return tuple(to_srgb(v) for v in (
            4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s))

    begun, goal = to_oklab(one), to_oklab(two)
    return from_oklab(tuple(x + (y - x) * progress for x, y in zip(begun, goal)))


# ---------------------------------------------------------------- greetd ---
class Greetd:
    """One conversation with greetd over its socket."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)

    def send(self, **request):
        payload = json.dumps(request).encode()
        self.sock.sendall(struct.pack("=I", len(payload)) + payload)
        (length,) = struct.unpack("=I", self._recv(4))
        return json.loads(self._recv(length))

    def _recv(self, n):
        data = b""
        while len(data) < n:
            chunk = self.sock.recv(n - len(data))
            if not chunk:
                raise ConnectionError("greetd closed the socket")
            data += chunk
        return data

    def close(self):
        self.sock.close()


# -------------------------------------------------------------- sessions ---
def sessions():
    """Session entries from the usual dirs: (id, name, argv, env)."""
    found = []
    for directory in SESSION_DIRS:
        for path in sorted(directory.glob("*.desktop")):
            entry = configparser.ConfigParser(interpolation=None)
            entry.read(path, encoding="utf-8")
            if not entry.has_section("Desktop Entry"):
                continue
            desktop = entry["Desktop Entry"]
            if desktop.getboolean("Hidden", False) or desktop.getboolean("NoDisplay", False):
                continue
            if "Exec" not in desktop:
                continue
            session_type = "wayland" if directory.name == "wayland-sessions" else "x11"
            env = [f"XDG_SESSION_TYPE={session_type}", f"XDG_SESSION_DESKTOP={path.stem}"]
            if desktop.get("DesktopNames"):
                env.append(f"XDG_CURRENT_DESKTOP={desktop['DesktopNames']}")
            found.append((path.stem, desktop.get("Name", path.stem),
                          shlex.split(desktop["Exec"]), env))
    return found


def users():
    """Login users: the ordinary UID range, with a shell that logs in."""
    names = []
    for entry in pwd.getpwall():
        if 1000 <= entry.pw_uid < 60000 and not entry.pw_shell.endswith(("nologin", "/false")):
            names.append(entry.pw_name)
    return sorted(names)


def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state):
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text(json.dumps(state))
    except OSError as error:
        print(f"monogreet: state not saved: {error}", file=sys.stderr)


# --------------------------------------------------------------- layouts ---
def layout_mark():
    """The bar's mark (waybar's niri/language, {shortDescription}): two
    letters of the current layout's name; empty with one layout or
    without niri."""
    if "NIRI_SOCKET" not in os.environ:
        return ""
    try:
        out = subprocess.run(["niri", "msg", "--json", "keyboard-layouts"],
                             capture_output=True, text=True, check=True, timeout=2).stdout
        layouts = json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""
    names = layouts.get("names", [])
    if len(names) < 2:
        return ""
    return names[layouts.get("current_idx", 0)][:2].lower()


# ------------------------------------------------------------------ page ---
def rgba(color, alpha=1.0):
    value = Gdk.RGBA()
    value.red, value.green, value.blue, value.alpha = (*color, alpha)
    return value


class Page(Gtk.Widget):
    """The whole screen as one widget, drawn with GTK's snapshot API
    (render nodes, no cairo): glass, ring, hour, the line, feedback, the
    power glyphs. Drawing records where the clickable words and glyphs
    landed, so the pointer can find them."""

    def __init__(self, greeter):
        super().__init__(hexpand=True, vexpand=True)
        self.greeter = greeter
        self.background = None
        if BACKGROUND.is_file():
            try:
                self.background = Gdk.Texture.new_from_filename(str(BACKGROUND))
            except GLib.Error as error:
                print(f"monogreet: background not loaded: {error}", file=sys.stderr)
        self.hit_boxes = {}          # name → (x0, y0, x1, y1), in output pixels
        self.hover = None
        self.scale = 1.0             # output pixels per logical unit, read at each draw
        # the field's opacity and its animation: value, where it is going,
        # where the current move began and when (frame-clock µs), the
        # tick callback moving it, the timer that allows the fade-out
        # once the field has been empty for FADE_TIMEOUT_MS, and its verdict
        self.fade = 0.0
        self.fade_goal = 0.0
        self.fade_begun = 0.0
        self.fade_started = 0
        self.fade_tick = None
        self.fade_timer = None
        self.fade_allowed = False
        # the edge's colour and its move between rest grey and the check's
        # lit: value, goal, where the current move began and when, and the
        # tick callback moving it
        self.edge = EDGE
        self.edge_goal = EDGE
        self.edge_begun = EDGE
        self.edge_started = 0
        self.edge_tick = None

    # -- primitives ------------------------------------------------------------
    def layout(self, string, size):
        """A pango layout of the string at a size in points (the lock's
        font_size), pinned to 96 dpi rather than the context's resolution
        so the number means the same here as in hyprlock.conf."""
        layout = self.create_pango_layout(string)
        description = Pango.FontDescription(FONT)
        description.set_absolute_size(size * POINT * Pango.SCALE)
        layout.set_font_description(description)
        return layout

    def measure_text(self, string, size):
        return self.layout(string, size).get_pixel_extents()[1].width

    def text(self, snapshot, string, size, color, x, y, anchor="center", name=None):
        """Draw text with its anchor at (x, y): the centre of its logical box
        ("center" — where pango puts this face's digits' and capitals' ink
        to half a pixel), its left edge at mid-height ("left"), or the
        centre of its ink ("ink", for a glyph, which has no baseline to
        respect). A name records a hit box for the pointer."""
        layout = self.layout(string, size)
        ink, logical = layout.get_pixel_extents()
        box = ink if anchor == "ink" else logical
        x0 = x if anchor == "left" else x - box.width / 2
        y0 = y - box.height / 2
        snapshot.save()
        snapshot.translate(Graphene.Point().init(x0 - box.x, y0 - box.y))
        snapshot.append_layout(layout, rgba(color))
        snapshot.restore()
        if name:
            self.hit_boxes[name] = (x0 - 8, y0 - 8, x0 + box.width + 8, y0 + box.height + 8)
        return box.width

    def marks(self, snapshot, parts, size, y):
        """A line of marks centred on cx — (name, string) each, the muted
        dot between them — at a size; a named mark lights under the
        pointer and records its hit box."""
        if not parts:
            return
        widths = [self.measure_text(string, size) for _, string in parts]
        dot = self.measure_text("·", size)
        gap = 18 * size / 16
        x = self.get_width() * self.scale / 2 - (sum(widths) + (dot + 2 * gap) * (len(parts) - 1)) / 2
        for i, ((name, string), w) in enumerate(zip(parts, widths)):
            if i:
                self.text(snapshot, "·", size, MUTED, x, y, anchor="left")
                x += dot + gap
            self.text(snapshot, string, size, LIT if name and self.hover == name else REST,
                      x, y, anchor="left", name=name)
            x += w + gap

    def ring(self, snapshot, rounded, color, alpha, clip=None):
        """The ring's edge — the border of a rounded rect whose radius is
        half its side — in one color at an opacity, optionally only inside
        a clip rect (a keystroke's quadrant)."""
        if clip is not None:
            snapshot.push_clip(clip)
        snapshot.append_border(rounded, [RING_WIDTH] * 4, [rgba(color, alpha)] * 4)
        if clip is not None:
            snapshot.pop()

    # -- the field's fade ----------------------------------------------------
    def update_fade(self, used):
        """hyprlock's fade_on_empty, decided at each draw as hyprlock decides
        it: a used field (something typed, or a check under way) comes to
        full opacity at once and cancels any pending fade-out; an unused
        one that is showing starts the timer, and fades once it has run
        out. Before the first keystroke the field is simply not there."""
        if used:
            self.fade_allowed = False
            if self.fade_timer is not None:
                GLib.source_remove(self.fade_timer)
                self.fade_timer = None
            if self.fade_goal != 1.0:
                self.fade_to(1.0)
        elif self.fade_goal != 0.0:
            if self.fade_allowed:
                self.fade_allowed = False
                self.fade_to(0.0)
            elif self.fade_timer is None:
                self.fade_timer = GLib.timeout_add(FADE_TIMEOUT_MS, self.on_fade_timeout)

    def on_fade_timeout(self):
        self.fade_timer = None
        self.fade_allowed = True
        self.queue_draw()
        return GLib.SOURCE_REMOVE

    def fade_to(self, goal):
        """Start moving the opacity from where it is to the goal, over
        FADE_MS on the curve; a move already under way is taken over from
        its current value, as hyprutils restarts an animated variable."""
        self.fade_begun, self.fade_goal = self.fade, goal
        self.fade_started = self.get_frame_clock().get_frame_time()
        if self.fade_tick is None:
            self.fade_tick = self.add_tick_callback(self.on_fade_tick)

    def on_fade_tick(self, _widget, clock):
        progress = (clock.get_frame_time() - self.fade_started) / (FADE_MS * 1000)
        if progress >= 1.0:
            self.fade = self.fade_goal
            self.fade_tick = None
            self.queue_draw()
            return GLib.SOURCE_REMOVE
        self.fade = self.fade_begun + (self.fade_goal - self.fade_begun) * ease(progress)
        self.queue_draw()
        return GLib.SOURCE_CONTINUE

    # -- the edge's colour -----------------------------------------------------
    def update_edge(self, goal):
        """hyprlock's outer colour, decided at each draw as hyprlock decides
        it (CPasswordInputField::updateColors): the check colour while a
        check is under way, the edge grey otherwise — a new goal starts a
        move from wherever the colour is, as hyprutils restarts an
        animated variable; a goal already set changes nothing."""
        if goal == self.edge_goal:
            return
        self.edge_begun, self.edge_goal = self.edge, goal
        self.edge_started = self.get_frame_clock().get_frame_time()
        if self.edge_tick is None:
            self.edge_tick = self.add_tick_callback(self.on_edge_tick)

    def on_edge_tick(self, _widget, clock):
        progress = (clock.get_frame_time() - self.edge_started) / (COLOR_MS * 1000)
        if progress >= 1.0:
            self.edge = self.edge_goal
            self.edge_tick = None
            self.queue_draw()
            return GLib.SOURCE_REMOVE
        self.edge = oklab_lerp(self.edge_begun, self.edge_goal, progress)
        self.queue_draw()
        return GLib.SOURCE_CONTINUE

    # -- the frame ---------------------------------------------------------
    def do_snapshot(self, snapshot):
        g = self.greeter
        # draw in the output's pixels: GTK lays the page out in logical
        # units and would scale the drawing up by the output's scale;
        # scaling it back down by the same factor makes one unit here one
        # pixel on the panel — the lock's and the splash's unit
        surface = self.get_native().get_surface() if self.get_native() else None
        self.scale = surface.get_scale() if surface else 1.0
        snapshot.scale(1 / self.scale, 1 / self.scale)
        width, height = self.get_width() * self.scale, self.get_height() * self.scale
        self.hit_boxes = {}
        full = Graphene.Rect().init(0, 0, width, height)

        # glass: the pre-rendered wallpaper covering the screen, else the ground
        snapshot.append_color(rgba(GROUND), full)
        if self.background:
            tw, th = self.background.get_width(), self.background.get_height()
            scale = max(width / tw, height / th)
            cover = Graphene.Rect().init((width - tw * scale) / 2, (height - th * scale) / 2,
                                         tw * scale, th * scale)
            snapshot.push_clip(full)
            snapshot.append_texture(self.background, cover)
            snapshot.pop()

        cx, cy = width / 2, height / 2

        # the field, at the opacity its fade has reached: the glass disc
        # (the lock's 40% ground), the edge — moving to the lit while the
        # password is checked, back to rest on the verdict — and, with
        # something typed, the one quadrant the last keystroke lit
        self.update_fade(bool(g.typed) or g.checking)
        self.update_edge(LIT if g.checking else EDGE)
        r = RING_RADIUS
        rect = Graphene.Rect().init(cx - r, cy - r, 2 * r, 2 * r)
        rounded = Gsk.RoundedRect()
        rounded.init_from_rect(rect, r)
        if self.fade > 0.0:
            snapshot.push_rounded_clip(rounded)
            snapshot.append_color(rgba(GROUND, 0.4 * self.fade), rect)
            snapshot.pop()
            self.ring(snapshot, rounded, self.edge, self.fade)
            if g.typed and g.quadrant is not None:
                quadrants = [(cx, cy - r), (cx, cy), (cx - r, cy), (cx - r, cy - r)]   # clockwise from top-right
                qx, qy = quadrants[g.quadrant]
                self.ring(snapshot, rounded, LIT, self.fade, Graphene.Rect().init(qx, qy, r, r))

        # inside: the hour, through the check as well (the lit ring is
        # the check's only sign, as on the lock); the date at the top
        self.text(snapshot, datetime.now().strftime("%H:%M"), 60, LIT, cx, cy)
        self.text(snapshot, datetime.now().strftime("%a %d %b"), 16, REST, cx, MARGIN)

        # user · session · layout, one line under the ring: the session
        # only when there is more than one to choose from (or none to
        # start), the layout only with more than one (layout_mark is
        # empty otherwise). A word is named — lit under the pointer,
        # cycling on click — only when there is something to cycle to.
        parts = [("user" if len(g.users) > 1 else None, g.user)]
        if len(g.sessions) != 1:
            parts.append(("session" if len(g.sessions) > 1 else None, g.session_name()))
        if g.layout:
            parts.append(("layout", g.layout))
        y = cy + LINE_Y
        self.marks(snapshot, parts, 16, y)

        # the feedback line under that, in the same size, as the lock has
        # it (bin/lock-line): "caps lock" while caps lock is on, then the
        # message — a prompt, or what went wrong — and a visible prompt
        # (an OTP, a question) shows the answer as it is typed
        words = [(None, "caps lock")] if g.caps_lock else []
        line = g.message
        if not g.secret and g.typed:
            line = f"{g.message}  {g.typed}" if g.message else g.typed
        if line:
            words.append((None, line))
        self.marks(snapshot, words, 16, y + 30)

        # the two glyphs that end the greeter, their ink centred the
        # date's distance from the bottom edge, 32px apart
        for name, glyph, dx in (("poweroff", POWER_GLYPH, -16), ("reboot", REBOOT_GLYPH, 16)):
            self.text(snapshot, glyph, 22, LIT if self.hover == name else MUTED,
                      cx + dx, height - MARGIN, anchor="ink", name=name)

    def hit(self, x, y):
        """The named thing under a pointer position (logical units, as GTK
        reports it) — the hit boxes are in output pixels."""
        x, y = x * self.scale, y * self.scale
        for name, (x0, y0, x1, y1) in self.hit_boxes.items():
            if x0 <= x <= x1 and y0 <= y <= y1:
                return name
        return None


# --------------------------------------------------------------- greeter ---
class Greeter(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.nafud.monogreet")
        self.users = users() or [pwd.getpwuid(os.getuid()).pw_name]
        self.sessions = sessions()
        state = load_state()
        self.user = state.get("user") if state.get("user") in self.users else self.users[0]
        ids = [s[0] for s in self.sessions]
        self.session_index = ids.index(state["session"]) if state.get("session") in ids else 0
        self.layout = layout_mark()
        self.typed = ""
        self.secret = True            # the current prompt hides its input
        self.quadrant = None          # the quadrant the last keystroke lit, 0..3 clockwise from top-right
        self.checking = False
        self.message = ""             # the line under the name: a prompt, or what went wrong
        self.transient_timer = None   # runs while a transient message ("wrong password") stands
        self.caps_lock = False        # the keyboard's caps lock, as GDK reports it
        self.answers = queue.Queue()  # the auth thread waits here for further answers
        self.in_conversation = False
        self.page = None

    # -- state ---------------------------------------------------------------
    def light(self):
        """What was typed changed: light one quadrant for it — a random one,
        never the one already lit (hyprlock's hidden input: last + 1..3) —
        or none, when nothing is typed."""
        if not self.typed:
            self.quadrant = None
        else:
            self.quadrant = random.choice([q for q in range(4) if q != self.quadrant])

    def clear(self):
        self.typed = ""
        self.quadrant = None

    def session_name(self):
        """The session's id (niri, sway…): the line is lowercase marks."""
        return self.sessions[self.session_index][0] if self.sessions else "no session"

    def say(self, message, transient=False):
        """Put a line under the name. A transient one — "wrong password" —
        stands for FAIL_TIMEOUT_MS or until the next keystroke, as
        hyprlock's fail display does; a prompt or an error stays until
        something replaces it."""
        self.message = message
        if self.transient_timer is not None:
            GLib.source_remove(self.transient_timer)
            self.transient_timer = None
        if transient and message:
            self.transient_timer = GLib.timeout_add(FAIL_TIMEOUT_MS, self.on_transient_timeout)
        self.page.queue_draw()

    def on_transient_timeout(self):
        self.transient_timer = None
        self.message = ""
        self.page.queue_draw()
        return GLib.SOURCE_REMOVE

    # -- window --------------------------------------------------------------
    def do_activate(self):
        window = Gtk.ApplicationWindow(application=self, title="monogreet")
        self.page = Page(self)
        window.set_child(self.page)
        window.set_decorated(False)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        window.add_controller(keys)
        click = Gtk.GestureClick()
        click.connect("released", self.on_click)
        self.page.add_controller(click)
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self.on_motion)
        self.page.add_controller(motion)

        window.fullscreen()
        window.present()
        GLib.timeout_add_seconds(1, self.tick)
        self.watch_layouts()
        self.watch_caps_lock()

    def tick(self):
        self.page.queue_draw()
        return True

    # -- caps lock -------------------------------------------------------------
    def watch_caps_lock(self):
        """The seat's keyboard carries the lock state GDK reads from the
        compositor's modifier events; its property changes as caps lock
        is pressed, here or on the lock before."""
        keyboard = Gdk.Display.get_default().get_default_seat().get_keyboard()
        if keyboard is None:
            return

        def on_change(device, _param):
            self.caps_lock = device.get_caps_lock_state()
            self.page.queue_draw()
        keyboard.connect("notify::caps-lock-state", on_change)
        on_change(keyboard, None)

    # -- layouts over niri's IPC ---------------------------------------------
    def watch_layouts(self):
        if "NIRI_SOCKET" not in os.environ:
            return
        try:
            stream = subprocess.Popen(["niri", "msg", "--json", "event-stream"],
                                      stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return

        def on_event(source, _condition):
            line = source.readline()
            if not line:
                return False
            if "KeyboardLayout" in line:
                self.layout = layout_mark()
                self.page.queue_draw()
            return True
        GLib.io_add_watch(stream.stdout, GLib.IO_IN | GLib.IO_HUP, on_event)

    # -- input ---------------------------------------------------------------
    def on_key(self, _controller, keyval, _keycode, _state):
        if self.checking:
            return True
        if self.transient_timer is not None:      # any keystroke clears the fail, as on the lock
            self.say("")
        if keyval == Gdk.KEY_Escape:
            self.clear()
            self.secret = True
            self.say("")
        elif keyval == Gdk.KEY_BackSpace:
            self.typed = self.typed[:-1]
            self.light()
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.submit()
        elif keyval == Gdk.KEY_Tab:
            self.cycle_session(1)
        elif keyval == Gdk.KEY_ISO_Left_Tab:
            self.cycle_session(-1)
        elif keyval in (Gdk.KEY_Up, Gdk.KEY_Down):
            self.cycle_user(-1 if keyval == Gdk.KEY_Up else 1)
        elif keyval == Gdk.KEY_F10:
            self.power("poweroff")
        elif keyval == Gdk.KEY_F11:
            self.power("reboot")
        else:
            char = Gdk.keyval_to_unicode(keyval)
            if char >= 32:
                self.typed += chr(char)
                self.light()
        self.page.queue_draw()
        return True

    def on_click(self, _gesture, _n, x, y):
        target = self.page.hit(x, y)
        if target == "user":
            self.cycle_user(1)
        elif target == "session":
            self.cycle_session(1)
        elif target == "layout":
            self.cycle_layout()
        elif target in ("poweroff", "reboot"):
            self.power(target)

    def on_motion(self, _controller, x, y):
        target = self.page.hit(x, y)
        if target != self.page.hover:
            self.page.hover = target
            self.page.set_cursor(Gdk.Cursor.new_from_name("pointer" if target else "default"))
            self.page.queue_draw()

    def cycle_user(self, step):
        self.user = self.users[(self.users.index(self.user) + step) % len(self.users)]
        self.clear()
        self.page.queue_draw()

    def cycle_session(self, step):
        if self.sessions:
            self.session_index = (self.session_index + step) % len(self.sessions)
        self.page.queue_draw()

    def cycle_layout(self):
        """The compositor switches; its event stream brings the new mark."""
        subprocess.Popen(["niri", "msg", "action", "switch-layout", "next"])

    def power(self, action):
        subprocess.Popen(["systemctl", action])

    # -- authentication ------------------------------------------------------
    def submit(self):
        if self.checking or not self.typed:      # hyprlock's ignore_empty_input
            return
        answer = self.typed
        self.clear()
        if self.in_conversation:
            self.answers.put(answer)             # answers a further prompt
            self.busy()
            return
        if not self.sessions:
            self.say("no session to start")
            return
        self.busy()
        self.say("")
        threading.Thread(target=self.converse, args=(self.user, answer), daemon=True).start()

    def converse(self, user, answer):
        """The greetd conversation for one login attempt, on its own thread:
        create the session, answer every prompt (the first with what was
        typed, later ones with what the user types next), start the
        session on success. UI changes go through the main loop."""
        self.in_conversation = True
        session_id, _, argv, env = self.sessions[self.session_index]
        try:
            greetd = Greetd(os.environ["GREETD_SOCK"])
        except (KeyError, OSError) as error:
            GLib.idle_add(self.finish, False, f"greetd unreachable: {error}")
            return
        try:
            reply = greetd.send(type="create_session", username=user)
            while True:
                kind = reply.get("type")
                if kind == "success":
                    reply = greetd.send(type="start_session", cmd=argv, env=env)
                    if reply.get("type") == "success":
                        save_state({"user": user, "session": session_id})
                        GLib.idle_add(self.quit)
                        return
                    GLib.idle_add(self.finish, False, reply.get("description", "session not started"))
                    return
                if kind == "auth_message":
                    prompt_type = reply.get("auth_message_type")
                    prompt = reply.get("auth_message", "").strip().rstrip(":")
                    if prompt_type in ("visible", "secret"):
                        if answer is None:
                            GLib.idle_add(self.ask, prompt, prompt_type == "secret")
                            answer = self.answers.get()
                        reply = greetd.send(type="post_auth_message_response", response=answer)
                        answer = None
                        GLib.idle_add(self.busy)
                    else:
                        GLib.idle_add(self.say, prompt)
                        reply = greetd.send(type="post_auth_message_response")
                    continue
                # error: auth_error is a wrong answer — said transiently, as
                # the lock says it; anything else is news that must stand
                description = reply.get("description", "login failed")
                greetd.send(type="cancel_session")
                if reply.get("error_type") == "auth_error":
                    GLib.idle_add(self.finish, False, "wrong password", True)
                else:
                    GLib.idle_add(self.finish, False, description)
                return
        except (OSError, ValueError) as error:
            GLib.idle_add(self.finish, False, f"greetd: {error}")
        finally:
            greetd.close()
            self.in_conversation = False

    def ask(self, prompt, secret):
        """A further prompt: show it, take the ring out of checking so the
        next line typed answers it."""
        self.secret = secret
        self.checking = False
        self.say(prompt or ("password" if secret else ""))

    def busy(self):
        """The ring lights until the answer comes."""
        self.checking = True
        self.page.queue_draw()

    def finish(self, ok, message, transient=False):
        self.checking = False
        self.secret = True
        if not ok:
            self.say(message, transient)


if __name__ == "__main__":
    sys.exit(Greeter().run([]))

# mono.script — the prompt on the flat ground, nothing else.
#
# The boot splash says only what it is asked to say: the ground is the
# desktop's 0d0d0d from the first frame to the greeter, and when
# plymouth asks for the passphrase, the prompt's text stands on the
# screen's centre — where the lock (config/hypr/hyprlock.conf) and the
# login page (system/usr/local/bin/monogreet) put their hour — in the
# face and size of their lines. The characters typed so far are a row
# of dots one line under it, growing out from the middle rather than
# from a field's left edge; a question (a visible answer) shows the
# answer there instead. A message, should one come, takes the line
# under that. Nothing is drawn while nothing is asked: no ring (the
# prompt is the whole screen; a ring around nothing said nothing), no
# throbber, no caps mark, no colour for a wrong passphrase — plymouth
# asks again, the dots start over. Images come from
# tools/render-plymouth-mono.

# --- the design's measures and palette ----------------------------------
LINE = 30;                         # line pitch: centre to the dots, dots to a message
PITCH = 12;                        # dot cell; the dot is 6px in its middle
MAX_DOTS = 20;                     # a row of 20 is 240px
# the lock's 16: a bare size is points at 96 dpi to label-freetype
# (FT_Set_Char_Size at 96 dpi — "16px" would be pixels), 21.3px like
# hyprlock's font_size 16 and the login page's line
FONT = "JetBrainsMono Nerd Font 16";
REST.r = 0.753; REST.g = 0.753; REST.b = 0.753;     # c0c0c0
LIT.r = 0.910; LIT.g = 0.910; LIT.b = 0.910;        # e8e8e8

Window.SetBackgroundTopColor(0.051, 0.051, 0.051);       # 0d0d0d
Window.SetBackgroundBottomColor(0.051, 0.051, 0.051);

# the screen centre (the first display's: the prompt sits on every
# display at these coordinates, and this machine has one)
cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

# --- sprites ------------------------------------------------------------
dot.image = Image("bullet.png");
for (i = 0; i < MAX_DOTS; i++) {
    dot.sprite[i] = Sprite(dot.image);
    dot.sprite[i].SetOpacity(0);
}

prompt.sprite = Sprite();          # the prompt, on the centre
answer.sprite = Sprite();          # a visible answer, one line under
message.sprite = Sprite();         # a message, one line under that

fun centred(sprite, image, x, y, z) {
    sprite.SetImage(image);
    sprite.SetPosition(x - image.GetWidth() / 2, y - image.GetHeight() / 2, z);
    sprite.SetOpacity(1);
}

# n dots, the row centred under the prompt: cell i of n starts at
# cx - n * PITCH / 2 + i * PITCH, and the dot is symmetric in its cell
fun show_dots(n) {
    if (n > MAX_DOTS) n = MAX_DOTS;
    for (i = 0; i < MAX_DOTS; i++) {
        if (i < n) {
            dot.sprite[i].SetPosition(cx - n * PITCH / 2 + i * PITCH, cy + LINE - PITCH / 2, 2);
            dot.sprite[i].SetOpacity(1);
        } else {
            dot.sprite[i].SetOpacity(0);
        }
    }
}

# NULL and "" both mean nothing to say: an ask with no prompt hands the
# script NULL, which would otherwise print as the script language's
# "#NULL"
fun show_prompt(text) {
    if (!text || text == "") prompt.sprite.SetOpacity(0);
    else centred(prompt.sprite, Image.Text(text, REST.r, REST.g, REST.b, 1, FONT), cx, cy, 3);
}

fun show_answer(text) {
    if (!text || text == "") answer.sprite.SetOpacity(0);
    else centred(answer.sprite, Image.Text(text, LIT.r, LIT.g, LIT.b, 1, FONT), cx, cy + LINE, 3);
}

# --- what plymouth tells us ---------------------------------------------
# nothing to ask: the ground alone (coming up, checking an answer, going on)
Plymouth.SetDisplayNormalFunction(fun() {
    show_dots(0);
    show_answer("");
    show_prompt("");
});

# a passphrase is asked, `bullets` characters typed so far
Plymouth.SetDisplayPasswordFunction(fun(prompt, bullets) {
    show_answer("");
    show_dots(bullets);
    show_prompt(prompt);
});

# a question is asked, `entry` typed so far, shown as it is
Plymouth.SetDisplayQuestionFunction(fun(prompt, entry) {
    show_dots(0);
    show_answer(entry);
    show_prompt(prompt);
});

Plymouth.SetDisplayMessageFunction(fun(text) {
    centred(message.sprite, Image.Text(text, REST.r, REST.g, REST.b, 1, FONT), cx, cy + 2 * LINE, 3);
});
Plymouth.SetHideMessageFunction(fun(text) {
    message.sprite.SetOpacity(0);
});

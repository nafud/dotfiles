[Plymouth Theme]
Name=Mono
Description=The desktop's glass from the first frame: a ring on the flat ground, still; the passphrase typed into it as a row of dots on its centre, the prompt one line under it.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/mono
ScriptFile=/usr/share/plymouth/themes/mono/mono.script
# The face of the bar, the lock and the login page, for the prompt under
# the ring. The mkinitcpio hook packs the file fc-match resolves for
# each of these two names into the initramfs; plymouth's label plugin
# draws any font whose name contains "Mono" from the MonospaceFont file,
# so both names are given and both are this face. (The size here is
# only read by the hook's regex; the script names its own.)
Font=JetBrainsMono Nerd Font 16
MonospaceFont=JetBrainsMono Nerd Font 16
